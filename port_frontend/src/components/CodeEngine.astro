---
// Code × Engine hybrid centerpiece. A schematic inline-4 whose right half is a
// fused circuit board — "I build software the way I build machines." Each hero
// part carries a section tag and separates during that section's scroll window.
const bores = [330, 400, 470, 540];
const hex = (hx: number, hy: number, r: number) =>
  Array.from({ length: 6 }, (_, k) => {
    const a = ((k * 60 - 90) * Math.PI) / 180;
    return `${(hx + r * Math.cos(a)).toFixed(1)},${(hy + r * Math.sin(a)).toFixed(1)}`;
  }).join(' ');
const traceY = [268, 292, 316, 340, 364, 388];
const headBolts = [312, 360, 408, 456, 504, 552];
---
<svg class="bp-svg" viewBox="0 0 860 560" role="img" aria-label="Exploded code-and-engine hybrid assembly">
  <!-- construction centre lines -->
  <g class="bp-part" data-static>
    <line class="bp-line-2" x1="60" y1="340" x2="800" y2="340" stroke-dasharray="2 6" opacity="0.35" />
    <line class="bp-line-2" x1="435" y1="70" x2="435" y2="500" stroke-dasharray="2 6" opacity="0.35" />
  </g>

  <!-- CORE (anchor): engine block + crankshaft — never separates -->
  <g class="bp-part" data-static>
    <rect class="bp-fill" x="290" y="250" width="290" height="150" rx="4" />
    {bores.map((x) => <rect class="bp-line-2" x={x - 22} y="250" width="44" height="118" rx="2" />)}
    <!-- crankshaft -->
    <line class="bp-line-2" x1="300" y1="418" x2="570" y2="418" />
    {bores.map((x) => <circle class="bp-line" cx={x} cy="418" r="16" />)}
    {bores.map((x) => <circle class="bp-line-2" cx={x} cy="418" r="5" />)}
  </g>

  <!-- 03 · WORK — pistons + rods -->
  <g class="bp-part" id="e-pistons" data-label="Pistons" data-section="#panel-work"
     data-dx="-120" data-dy="-262" data-start="0.40" data-end="0.58">
    {bores.map((x) => (
      <>
        <rect class="bp-fill" x={x - 18} y="280" width="36" height="40" rx="3" />
        <line class="bp-line-2" x1={x} y1="284" x2={x} y2="314" />
        <circle class="bp-line" cx={x} cy="322" r="5" />
        <line class="bp-line" x1={x} y1="322" x2={x} y2="360" stroke-width="2" />
      </>
    ))}
    <g class="part-tag"><text x="435" y="238" text-anchor="middle">03 · WORK</text></g>
  </g>

  <!-- 01 · ABOUT — cam cover / head -->
  <g class="bp-part" id="e-head" data-label="Cam Cover" data-section="#panel-about"
     data-dx="0" data-dy="-232" data-start="0.02" data-end="0.16">
    <rect class="bp-fill" x="286" y="204" width="298" height="46" rx="5" />
    <circle class="bp-line" cx="360" cy="227" r="13" />
    <circle class="bp-line" cx="510" cy="227" r="13" />
    <line class="bp-line-2" x1="360" y1="227" x2="510" y2="227" />
    {headBolts.map((x) => <circle class="bp-line-2" cx={x} cy="213" r="3.5" />)}
    <g class="part-tag"><text x="435" y="192" text-anchor="middle">01 · ABOUT</text></g>
  </g>

  <!-- 02 · STACK — fused circuit board (the "code" half) -->
  <g class="bp-part" id="e-pcb" data-label="Logic Board" data-section="#panel-stack"
     data-dx="216" data-dy="-140" data-rot="6" data-start="0.20" data-end="0.36">
    <rect class="bp-fill" x="600" y="250" width="168" height="150" rx="4" />
    {traceY.map((y) => <line class="bp-line-2" x1="612" y1={y} x2="756" y2={y} />)}
    <line class="bp-line-2" x1="660" y1="256" x2="660" y2="394" />
    <line class="bp-line-2" x1="708" y1="256" x2="708" y2="394" />
    <rect class="bp-line" x="624" y="286" width="48" height="34" rx="2" />
    <rect class="bp-line" x="700" y="330" width="44" height="40" rx="2" />
    {[628, 640, 652, 664].map((x) => <line class="bp-line" x1={x} y1="320" x2={x} y2="330" />)}
    <g class="part-tag"><text x="684" y="240" text-anchor="middle">02 · STACK</text></g>
  </g>

  <!-- 04 · GARAGE — turbocharger -->
  <g class="bp-part" id="e-turbo" data-label="Turbo" data-section="#panel-garage"
     data-dx="196" data-dy="188" data-rot="-30" data-start="0.62" data-end="0.78">
    <circle class="bp-fill" cx="612" cy="430" r="42" />
    <circle class="bp-line" cx="612" cy="430" r="26" />
    <circle class="bp-line-2" cx="612" cy="430" r="9" />
    {[0, 45, 90, 135, 180, 225, 270, 315].map((d) => {
      const a = (d * Math.PI) / 180;
      return <line class="bp-line-2" x1={(612 + 10 * Math.cos(a)).toFixed(1)} y1={(430 + 10 * Math.sin(a)).toFixed(1)} x2={(612 + 25 * Math.cos(a)).toFixed(1)} y2={(430 + 25 * Math.sin(a)).toFixed(1)} />;
    })}
    <path class="bp-line" d="M654,430 a42,42 0 0 0 -20,-36 l10,-14" fill="none" />
    <g class="part-tag"><text x="612" y="486" text-anchor="middle">04 · GARAGE</text></g>
  </g>

  <!-- 05 · CONTACT — ECU -->
  <g class="bp-part" id="e-ecu" data-label="ECU" data-section="#panel-contact"
     data-dx="-232" data-dy="118" data-start="0.82" data-end="0.97">
    <rect class="bp-fill" x="228" y="316" width="74" height="52" rx="3" />
    <rect class="bp-line-2" x="240" y="326" width="50" height="20" rx="1" />
    {[236, 248, 260, 272, 284, 296].map((x) => <line class="bp-line" x1={x} y1="368" x2={x} y2="378" />)}
    <circle class="bp-line-2" cx="265" cy="356" r="3" />
    <g class="part-tag"><text x="265" y="306" text-anchor="middle">05 · CONTACT</text></g>
  </g>
</svg>
