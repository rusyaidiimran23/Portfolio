---
import Base from '../layouts/Base.astro';
---
<Base title="Garage — Rusyaidi Yeng" description="Private build logs." noindex>
  <nav class="titlebar">
    <div class="wrap tb-inner">
      <a class="brand display" href="/"><span class="num">07</span><span>RUSYAIDI <b>YENG</b></span></a>
      <a class="back mono" href="/">◂ <span class="bk-long">Back to the paddock</span><span class="bk-short">Back</span></a>
    </div>
  </nav>

  <main class="wrap page">
    <!-- LOCK SCREEN: pit-lane checkpoint -->
    <section id="gate" class="gate">
      <div class="gate-word display" aria-hidden="true">PIT LANE</div>
      <canvas id="gate-board" class="gate-board" role="img" aria-label="Authorised crew only"></canvas>
      <p class="eyebrow">Pit lane — authorised crew only</p>
      <h1 class="gate-title display">The Garage</h1>
      <p class="muted">Build logs for the Cefiro, ZX-4RR &amp; CBR250RR. Crew password required.</p>
      <form id="auth-form" class="auth">
        <label class="sr" for="pw">Password</label>
        <input id="pw" type="password" placeholder="ENTER CREW CODE" autocomplete="current-password" />
        <button class="btn btn-primary" type="submit">Unlock ▸</button>
      </form>
      <p class="err lcd-text" id="auth-err" aria-live="polite"></p>
    </section>

    <!-- UNLOCKED -->
    <section id="content" hidden>
      <header class="g-head">
        <div>
          <p class="eyebrow">Pit lane — unlocked</p>
          <h1 class="g-title display">The Garage</h1>
        </div>
        <button class="btn" id="lock-out" type="button">Lock again</button>
      </header>
      <!-- Forza-style menu: GARAGE <-> TRACK DAY screens -->
      <nav class="fzm" id="fzm" aria-label="Garage screens">
        <span class="fzm-key mono" aria-hidden="true">Q</span>
        <button class="fzm-tab" type="button" data-pane-go="garage" aria-selected="true">Garage</button>
        <button class="fzm-tab" type="button" data-pane-go="track" aria-selected="false">Track Day</button>
        <button class="fzm-tab" type="button" data-pane-go="stats" aria-selected="false">Stats</button>
        <span class="fzm-key mono" aria-hidden="true">E</span>
        <i class="fzm-ink" aria-hidden="true"></i>
      </nav>
      <div class="kerb"></div>

      <div class="panes" id="panes">
        <div class="pane on" data-pane="garage">
        <!-- Forza-style garage: pick a vehicle, its card opens below -->
        <section class="fz" id="select" aria-label="Choose a vehicle">
          <div class="fz-head">
            <p class="eyebrow">My garage — choose a vehicle</p>
            <span class="fz-count lcd-text" id="fz-count"></span>
          </div>
          <div class="fz-grid" id="fz-grid"></div>
        </section>
        <div id="builds" class="builds"></div>

        </div>

        <div class="pane" data-pane="track" hidden>
        <!-- TRACK DAY: personal bests per track, ghost lap on the map -->
        <section class="td" id="trackday" aria-label="Track day">
          <div class="td-head">
            <div><p class="eyebrow">Track day — personal bests</p><h2 class="td-title display">Track Day</h2></div>
            <span class="td-count lcd-text" id="td-count"></span>
          </div>
          <div class="td-tabs" id="td-tabs" role="tablist" aria-label="Tracks"></div>
          <div class="td-stage" id="td-stage"></div>
        </section>
        </div>

        <div class="pane" data-pane="stats" hidden>
        <!-- STATS: who's been visiting the public site (private, from /api/stats) -->
        <section class="st" id="stats" aria-label="Visitor stats">
          <div class="td-head">
            <div><p class="eyebrow">Telemetry — who's watching</p><h2 class="td-title display">Stats</h2></div>
            <span class="td-count lcd-text" id="st-upd">--</span>
          </div>
          <div class="st-body" id="st-body"><p class="st-empty mono">Loading telemetry…</p></div>
        </section>
        </div>
      </div>

      <!-- edge arrows + the slash that sweeps across on a screen change -->
      <button class="edge edge-next" type="button" data-pane-go="track" aria-label="Go to Track Day"><span>Track Day</span><b>▸</b></button>
      <button class="edge edge-prev" type="button" data-pane-go="garage" aria-label="Back to Garage" hidden><b>◂</b><span>Garage</span></button>
      <div class="slash" id="slash" aria-hidden="true"><span id="slash-label"></span></div>
    </section>
  </main>
</Base>

<style>
  /* --- nav ------------------------------------------------------------------- */
  .titlebar {
    position: fixed; top: 5px; left: 0; right: 0; z-index: 40;
    background: rgba(7, 7, 10, 0.78); backdrop-filter: blur(12px); border-bottom: 1px solid var(--line);
  }
  .tb-inner { display: flex; align-items: center; justify-content: space-between; padding: 0.7rem 0; }
  .brand { display: flex; align-items: center; gap: 0.55rem; font-size: 1.35rem; letter-spacing: 0.02em; }
  .brand .num {
    font-size: 0.9rem; padding: 0.1rem 0.45rem; background: var(--f1red); color: #fff;
    clip-path: polygon(6px 0, 100% 0, calc(100% - 6px) 100%, 0 100%);
  }
  .brand b { color: var(--pink); }
  .back { color: var(--muted); font-size: 0.74rem; letter-spacing: 0.16em; text-transform: uppercase; }
  .back:hover { color: var(--ink); }
  .bk-short { display: none; }
  @media (max-width: 620px) { .bk-long { display: none; } .bk-short { display: inline; } }
  .page { position: relative; z-index: 2; padding: 7rem 0 6rem; min-height: 100vh; overflow-x: clip; }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

  /* --- lock screen ----------------------------------------------------------- */
  .gate { position: relative; max-width: 760px; margin: 4vh auto 0; text-align: center; animation: gate-in 0.9s cubic-bezier(0.16, 1, 0.3, 1) both; }
  @keyframes gate-in { from { opacity: 0; transform: translateY(40px); } }
  .gate-word {
    position: absolute; z-index: -1; left: 50%; top: -3rem; transform: translateX(-50%);
    font-size: clamp(6rem, 18vw, 15rem); font-style: italic; line-height: 1; white-space: nowrap;
    color: transparent; -webkit-text-stroke: 1.5px rgba(255, 255, 255, 0.07); pointer-events: none;
  }
  .gate-board {
    display: block; width: 100%; aspect-ratio: 128 / 41; margin-bottom: 2.2rem; border-radius: 6px;
    box-shadow: 0 0 0 1px #1b1b22, 0 0 0 6px #0a0a0d, 0 0 0 7px #1b1b22, 0 40px 90px -40px rgba(255, 30, 45, 0.55);
  }
  .gate-title { font-size: clamp(2.6rem, 7vw, 4.6rem); font-style: italic; text-transform: uppercase; margin: 0.4rem 0 0.6rem; }
  .muted { color: var(--muted); margin: 0; }
  .auth { display: flex; gap: 0.6rem; max-width: 480px; margin: 1.8rem auto 0; }
  .auth input {
    flex: 1; padding: 0.85rem 1rem; font-family: var(--mono); font-size: 1rem; letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--lime); caret-color: var(--lime); background: #030304; border: 1px solid #1f1f28;
  }
  .auth input::placeholder { color: #4a4a55; }
  .auth input:focus { outline: none; border-color: var(--lime); box-shadow: 0 0 0 1px var(--lime), 0 0 18px rgba(182, 255, 46, 0.2); }
  .err { --c: var(--f1red); min-height: 1.4em; margin: 1rem 0 0; font-size: 1.1rem; letter-spacing: 0.12em; }
  .gate.denied .auth { animation: denied 0.4s; }
  @keyframes denied { 20%, 60% { transform: translateX(-10px); } 40%, 80% { transform: translateX(10px); } }

  /* --- unlocked ------------------------------------------------------------- */
  .g-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.6rem; }
  .g-title { font-size: clamp(2.6rem, 7vw, 4.6rem); font-style: italic; text-transform: uppercase; margin-top: 0.35rem; }
  .builds { display: grid; gap: 2rem; margin-top: 2.4rem; }

  .builds :global(.build) {
    display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    background: linear-gradient(180deg, #0d0d12, #08080b); border: 1px solid #1c1c24; border-top: 3px solid var(--c);
    overflow: hidden; /* entrance animations stay inside the frame */
  }
  .builds :global(.build:nth-child(even) .b-media) { order: 2; }

  /* media: broadcast slides (photos) or the LED board */
  .builds :global(.b-media) { position: relative; min-height: 420px; overflow: hidden; background: #060608; }
  .builds :global(.b-slide) {
    position: absolute; inset: 0; margin: 0; clip-path: polygon(0 0, 0 0, -20% 100%, -20% 100%);
  }
  .builds :global(.b-slide.prev) { clip-path: polygon(0 0, 120% 0, 100% 100%, -20% 100%); z-index: 1; }
  .builds :global(.b-slide.on) { clip-path: polygon(0 0, 120% 0, 100% 100%, -20% 100%); z-index: 2; transition: clip-path 0.85s cubic-bezier(0.77, 0, 0.18, 1), transform 0.35s ease; }
  .builds :global(.b-media.rev .b-slide:not(.on):not(.prev)) { clip-path: polygon(120% 0, 120% 0, 100% 100%, 100% 100%); }
  .builds :global(.b-media) { cursor: grab; user-select: none; }
  .builds :global(.b-slide img) { width: 100%; height: 100%; object-fit: cover; }
  .builds :global(.b-slide.on img) { animation: push 6.5s ease-out both; }
  @keyframes push { from { transform: scale(1.1); } to { transform: scale(1); } }
  .builds :global(.b-cap) {
    position: absolute; z-index: 3; left: 0; bottom: 0; right: 0; padding: 2.4rem 1.2rem 1rem;
    font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.06em; color: #e6e6ec;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.85));
  }
  .builds :global(.b-media::before) {
    content: ''; position: absolute; z-index: 4; left: -3%; bottom: 0; width: 42%; height: 7px;
    background: var(--c); transform: skewX(-35deg); transform-origin: left bottom;
  }
  .builds :global(.b-board) { position: absolute; inset: 0; display: grid; place-items: center; padding: 1.4rem; }
  .builds :global(.b-board canvas) { width: 100%; aspect-ratio: 128 / 41; border-radius: 4px; }

  .builds :global(.b-body) { display: flex; flex-direction: column; gap: 1rem; padding: 1.8rem 1.8rem 1.6rem; min-width: 0; }
  .builds :global(.b-top) { display: flex; align-items: center; gap: 0.8rem; }
  .builds :global(.b-tag) { font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.2em; padding: 0.15rem 0.55rem; color: #000; background: var(--c); }
  .builds :global(.b-status) { margin-left: auto; font-size: 1rem; letter-spacing: 0.08em; }
  .builds :global(.b-status i) { display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: currentColor; box-shadow: 0 0 8px currentColor; margin-right: 0.5rem; animation: pulse 1.4s ease-in-out infinite; }
  @keyframes pulse { 50% { opacity: 0.3; } }
  .builds :global(.b-body h2) { font-size: clamp(1.8rem, 3.2vw, 2.6rem); font-style: italic; text-transform: uppercase; line-height: 1; }

  /* spec tiles */
  .builds :global(.tiles) { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.5rem; }
  .builds :global(.tile) { padding: 0.7rem 0.8rem; }
  .builds :global(.tile > *) { position: relative; z-index: 1; }
  .builds :global(.tile span) { display: block; font-family: var(--mono); font-size: 0.56rem; letter-spacing: 0.22em; color: var(--muted); margin-bottom: 0.3rem; }
  .builds :global(.tile b) { --c2: var(--c); display: block; font-size: 1rem; color: var(--c); text-shadow: 0 0 10px color-mix(in srgb, var(--c) 50%, transparent); }

  /* --- Track Day ------------------------------------------------------------------- */
  .td { margin-top: 2.2rem; scroll-margin-top: 90px; }
  .td-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 1rem; flex-wrap: wrap; margin: 1.6rem 0 1.2rem; }
  .td-title { font-size: clamp(2.4rem, 6vw, 4rem); font-style: italic; text-transform: uppercase; margin-top: 0.35rem; }
  .td-count { --c: var(--purple); font-size: 1rem; letter-spacing: 0.1em; }

  .td-tabs { display: flex; gap: 0.5rem; overflow-x: auto; scrollbar-width: none; padding-bottom: 0.2rem; }
  .td-tabs::-webkit-scrollbar { display: none; }
  .td-tabs :global(.td-tab) {
    flex: 1 0 auto; display: grid; gap: 0.15rem; text-align: left; cursor: pointer; padding: 0.7rem 1.2rem 0.75rem 1rem;
    color: var(--muted); background: #0b0b10; border: 1px solid #1f1f28; border-bottom: 3px solid #1f1f28;
    clip-path: polygon(10px 0, 100% 0, calc(100% - 10px) 100%, 0 100%); transition: color 0.2s, background 0.2s, border-color 0.2s;
  }
  .td-tabs :global(.tt-name) { font-family: var(--display); font-weight: 700; font-style: italic; text-transform: uppercase; font-size: 1rem; white-space: nowrap; }
  .td-tabs :global(.tt-sub) { font-size: 0.62rem; letter-spacing: 0.2em; }
  .td-tabs :global(.td-tab:hover) { color: var(--ink); }
  .td-tabs :global(.td-tab[aria-selected="true"]) { color: #fff; background: color-mix(in srgb, var(--c) 14%, #0b0b10); border-bottom-color: var(--c); }

  .td-stage {
    display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); margin-top: 0.8rem;
    background: linear-gradient(180deg, #0d0d12, #08080b); border: 1px solid #1c1c24; border-top: 3px solid var(--c);
  }
  .td-stage :global(.td-mapwrap) {
    position: relative; min-height: 380px; display: grid; place-items: center; padding: 1rem;
    background: radial-gradient(70% 70% at 50% 50%, color-mix(in srgb, var(--c) 12%, transparent), transparent 70%), #050507;
  }
  .td-stage :global(.td-map) { width: 100%; height: auto; display: block; }
  .td-stage :global(.td-map .dot) { fill: rgba(255, 255, 255, 0.06); }
  .td-stage :global(.tarmac) { fill: none; stroke: #16161d; stroke-width: 30; stroke-linejoin: round; }
  .td-stage :global(.kerbline) { fill: none; stroke: rgba(255, 255, 255, 0.12); stroke-width: 34; stroke-linejoin: round; stroke-dasharray: 10 10; opacity: 0.5; }
  .td-stage :global(.race-line) {
    fill: none; stroke: var(--c); stroke-width: 5; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 1000;
  }
  .td-stage :global(.sz.on .race-line) { animation: draw-line 2.4s cubic-bezier(0.65, 0, 0.35, 1) both; }
  @keyframes draw-line { from { stroke-dashoffset: 1000; } }
  .td-stage :global(.start) { stroke: #fff; stroke-width: 5; stroke-dasharray: 5 5; }
  .td-stage :global(.lbl) { font-family: var(--mono); font-size: 16px; letter-spacing: 0.2em; fill: #8b8b98; }
  .td-stage :global(.lbl.dim) { fill: #4a4a56; }
  .td-stage :global(.ghost-dot) { fill: #fff; }
  .td-stage :global(.ghost-halo) { fill: var(--c); opacity: 0.45; filter: blur(5px); }
  .td-stage :global(.ghost-tag) {
    position: absolute; left: 1rem; bottom: 0.9rem; font-size: 0.66rem; letter-spacing: 0.2em; color: var(--c);
  }
  /* trace pending placeholder */
  .td-stage :global(.pend-line) { fill: none; stroke: var(--c); stroke-width: 4; stroke-dasharray: 14 16; opacity: 0.55; animation: pend 3s linear infinite; }
  @keyframes pend { to { stroke-dashoffset: -60; } }
  .td-stage :global(.pend-big) { font-family: var(--display); font-weight: 900; font-style: italic; font-size: 58px; text-anchor: middle; fill: transparent; stroke: var(--c); stroke-width: 1.5; letter-spacing: 2px; }
  .td-stage :global(.pend-small) { font-family: var(--mono); font-size: 17px; text-anchor: middle; fill: #8b8b98; letter-spacing: 1px; }
  .td-stage :global(.scan) { stroke: var(--c); stroke-width: 2; opacity: 0.35; animation: scan-x 3.5s ease-in-out infinite alternate; }
  @keyframes scan-x { to { transform: translateX(1000px); } }

  .td-stage :global(.td-info) { display: flex; flex-direction: column; gap: 0.9rem; padding: 1.5rem 1.6rem; min-width: 0; }
  .td-stage :global(.td-top) { display: flex; align-items: center; gap: 0.7rem; }
  .td-stage :global(.td-chip) { font-family: var(--mono); font-size: 0.66rem; letter-spacing: 0.2em; text-transform: uppercase; padding: 0.2rem 0.6rem; color: #000; background: var(--c); }
  .td-stage :global(.td-chip.planned) { color: var(--c); background: none; border: 1px dashed var(--c); }
  .td-stage :global(.td-alias) { color: var(--muted); font-size: 0.72rem; letter-spacing: 0.2em; }
  .td-stage :global(.td-name) { font-size: clamp(1.6rem, 3vw, 2.3rem); font-style: italic; text-transform: uppercase; line-height: 1; }
  .td-stage :global(.td-facts) { margin: 0; color: var(--muted); font-size: 0.72rem; letter-spacing: 0.14em; text-transform: uppercase; }
  .td-stage :global(.td-pb) { display: grid; gap: 0.25rem; padding: 0.9rem 1rem; }
  .td-stage :global(.td-pb > *) { position: relative; z-index: 1; }
  .td-stage :global(.td-pb span) { font-family: var(--mono); font-size: 0.6rem; letter-spacing: 0.24em; color: var(--muted); }
  .td-stage :global(.td-pb b) { --c2: var(--purple); color: var(--purple); font-size: clamp(2rem, 4vw, 2.8rem); line-height: 1; }
  .td-stage :global(.td-pb em) { font-style: normal; font-size: 0.72rem; color: #b9b9c4; }
  .td-stage :global(.td-bar) { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .td-stage :global(.td-bar .eyebrow) { margin: 0; }
  .td-stage :global(.td-form) { display: grid; gap: 0.5rem; padding: 0.8rem; background: #050507; border: 1px solid color-mix(in srgb, var(--c) 45%, #1c1c24); }
  .td-stage :global(.td-form[hidden]) { display: none; }
  .td-stage :global(.tf-row) { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; }
  .td-stage :global(.td-form input), .td-stage :global(.td-form select) {
    width: 100%; padding: 0.65rem 0.8rem; font-family: var(--mono); font-size: 0.92rem; color: var(--lime);
    background: #030304; border: 1px solid #1f1f28; color-scheme: dark;
  }
  .td-stage :global(.td-form input:focus), .td-stage :global(.td-form select:focus) { outline: none; border-color: var(--lime); }
  .td-stage :global(.td-sessions) { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.35rem; max-height: 18rem; overflow-y: auto; }
  .td-stage :global(.td-sessions li) {
    display: grid; grid-template-columns: auto auto auto 1fr auto; gap: 0.9rem; align-items: baseline;
    padding: 0.6rem 0.6rem 0.6rem 0.9rem; background: #060608; border-left: 3px solid #2a2a33;
  }
  .td-stage :global(.td-sessions li.pb) { border-left-color: var(--purple); background: color-mix(in srgb, var(--purple) 10%, #060608); }
  .td-stage :global(.td-sessions li.empty) { grid-template-columns: 1fr; color: var(--muted); border-left-style: dashed; }
  .td-stage :global(.ts-date) { --c2: var(--amber); color: var(--amber); font-size: 0.9rem; }
  .td-stage :global(.ts-lap) { --c2: var(--ink); color: var(--ink); font-size: 1rem; }
  .td-stage :global(.ts-delta) { font-size: 0.72rem; color: var(--muted); }
  .td-stage :global(li.pb .ts-delta) { color: var(--purple); }
  .td-stage :global(.ts-meta) { color: #b9b9c4; font-size: 0.85rem; min-width: 0; overflow-wrap: anywhere; }
  .td-stage :global(.del) { border: 0; background: none; cursor: pointer; color: #4a4a55; font-family: var(--mono); font-size: 0.75rem; }
  .td-stage :global(.del.armed) { color: #fff; background: var(--f1red); }

  /* lazy-susan carousel: every track is a hologram riding round one orbit ---------- */
  .td-stage { --dir: 1; overflow: hidden; }
  .td-stage :global(.td-mapwrap) { overflow: hidden; padding: 0; }
  .td-stage :global(.susan) {
    position: relative; z-index: 1; width: 100%; height: 420px; touch-action: pan-y; cursor: grab; user-select: none;
  }
  .td-stage.spinning :global(.susan) { cursor: grabbing; }
  /* the orbit the tracks ride on: just light, no physical disc */
  .td-stage :global(.orbit) { position: absolute; left: 16%; width: 68%; top: 45%; height: 30%; overflow: visible; pointer-events: none; }
  .td-stage :global(.orbit ellipse) { fill: none; vector-effect: non-scaling-stroke; }
  .td-stage :global(.orbit .o-glow) { stroke: rgba(255, 255, 255, 0.06); stroke-width: 14; filter: blur(6px); }
  .td-stage :global(.orbit .o-line) { stroke: rgba(255, 255, 255, 0.22); stroke-width: 1; stroke-dasharray: 2 9; }
  .td-stage :global(.sz) {
    position: absolute; left: 50%; top: 60%; width: min(76%, 520px); transform-origin: 50% 88%;
    will-change: transform, opacity; cursor: pointer;
  }
  /* pool of light where the hologram is projected from */
  .td-stage :global(.sz::before) {
    content: ''; position: absolute; left: 18%; right: 18%; bottom: 4%; height: 22%; border-radius: 50%; pointer-events: none;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--c) 45%, transparent), transparent);
    filter: blur(4px); opacity: 0.8;
  }
  .td-stage :global(.sz-holo) { position: relative; animation: bob 4.5s ease-in-out infinite; }
  .td-stage :global(.sz:nth-child(3n) .sz-holo) { animation-delay: -1.5s; }
  .td-stage :global(.sz:nth-child(3n+1) .sz-holo) { animation-delay: -3s; }
  @keyframes bob {
    0%, 100% { transform: perspective(900px) rotateX(50deg) translateY(0); }
    50% { transform: perspective(900px) rotateX(50deg) translateY(-14px); }
  }
  .td-stage :global(.sz-holo > svg) { width: 100%; height: auto; display: block; overflow: visible; animation: holo-flicker 5s steps(1) infinite; }
  /* scanlines across the projection */
  .td-stage :global(.sz-holo::after) {
    content: ''; position: absolute; inset: 0; pointer-events: none; mix-blend-mode: screen;
    background: repeating-linear-gradient(0deg, color-mix(in srgb, var(--c) 22%, transparent) 0 1px, transparent 1px 5px);
    -webkit-mask: radial-gradient(ellipse at center, #000 35%, transparent 72%); mask: radial-gradient(ellipse at center, #000 35%, transparent 72%);
    animation: scanlines 3s linear infinite;
  }
  @keyframes scanlines { to { background-position: 0 40px; } }
  @keyframes holo-flicker { 0%, 100% { opacity: 1; } 42% { opacity: 0.82; } 43% { opacity: 1; } 77% { opacity: 0.9; } 78% { opacity: 1; } }
  /* hologram colouring of the tracks */
  .td-stage :global(.sz .tarmac) { stroke: color-mix(in srgb, var(--c) 14%, transparent); }
  .td-stage :global(.sz .kerbline) { stroke: color-mix(in srgb, var(--c) 30%, transparent); opacity: 0.55; }
  .td-stage :global(.sz .race-line) { filter: drop-shadow(0 0 6px var(--c)) drop-shadow(0 0 18px var(--c)); }
  .td-stage :global(.sz .start) { stroke: color-mix(in srgb, var(--c) 40%, #fff); }
  .td-stage :global(.sz .lbl) { fill: color-mix(in srgb, var(--c) 65%, #fff); transition: opacity 0.4s; }
  .td-stage :global(.sz .lbl.dim) { fill: color-mix(in srgb, var(--c) 45%, transparent); }
  .td-stage :global(.sz:not(.on) .lbl), .td-stage :global(.sz:not(.on) .pend-small) { opacity: 0; }
  .td-stage :global(.sz .scan) { display: none; }
  .td-stage :global(.sz-tag) {
    position: absolute; left: 50%; top: 100%; transform: translateX(-50%); margin-top: 0.2rem; white-space: nowrap;
    font-size: 0.7rem; letter-spacing: 0.24em; color: var(--c); text-shadow: 0 0 10px var(--c); transition: opacity 0.4s;
  }
  .td-stage :global(.sz.on .sz-tag) { opacity: 0; }

  /* pointer spotlight */
  .td-stage :global(.td-mapwrap::before) {
    content: ''; position: absolute; inset: 0; z-index: 0; pointer-events: none; opacity: 0; transition: opacity 0.35s;
    background: radial-gradient(240px circle at var(--mx, 50%) var(--my, 50%), color-mix(in srgb, var(--c) 20%, transparent), transparent 70%);
  }
  .td-stage :global(.td-mapwrap:hover::before) { opacity: 1; }
  .td-stage :global(.td-hud) {
    position: absolute; top: 0.9rem; left: 1rem; z-index: 2; display: flex; gap: 0.8rem; align-items: center;
    font-size: 0.66rem; letter-spacing: 0.2em; color: var(--muted); pointer-events: none;
  }
  .td-stage :global(.td-hud b) { font-weight: 400; color: var(--c); }
  .td-stage :global(.td-hud i) { font-style: normal; }
  .td-stage :global(.hud-lock) { display: none; color: var(--c); }
  .td-stage :global(.hud-hint) { position: absolute; right: 1rem; bottom: 0.9rem; z-index: 2; font-size: 0.62rem; letter-spacing: 0.2em; color: #5a5a66; pointer-events: none; }
  .td-stage :global(.ghost-tag) { z-index: 2; }

  /* info panel: out, then in */
  .td-stage.td-out :global(.td-info > *), .td-stage.td-out :global(.ghost-tag), .td-stage.td-out :global(.td-hud) { animation: info-out 0.22s ease-in forwards; }
  @keyframes info-out { to { transform: translateX(calc(var(--dir) * -28px)); opacity: 0; } }
  .td-stage.td-in :global(.hud-lock) { display: inline; animation: blink 0.18s steps(2) 6, hide 0s 1.1s forwards; }
  .td-stage.td-in :global(.hud-ok) { animation: hud-ok 0.3s 1.1s both; }
  @keyframes blink { 50% { opacity: 0; } }
  @keyframes hide { to { display: none; } }
  @keyframes hud-ok { from { opacity: 0; transform: translateX(-6px); } }
  .td-stage.td-in :global(.td-info > *) { animation: info-in 0.55s cubic-bezier(0.15, 0.85, 0.25, 1) both; animation-delay: calc(var(--i, 0) * 70ms + 120ms); }
  .td-stage.td-in :global(.td-name) { animation-name: name-in; }
  @keyframes info-in { from { transform: translateX(calc(var(--dir) * 34px)); opacity: 0; } }
  @keyframes name-in { from { clip-path: inset(0 100% 0 0); transform: translateX(calc(var(--dir) * 20px)) skewX(-10deg); } to { clip-path: inset(0 -10% 0 0); } }
  .td-stage :global(.td-info > :nth-child(2)) { --i: 1; }
  .td-stage :global(.td-info > :nth-child(3)) { --i: 2; }
  .td-stage :global(.td-info > :nth-child(4)) { --i: 3; }
  .td-stage :global(.td-info > :nth-child(5)) { --i: 4; }
  .td-stage :global(.td-info > :nth-child(n+6)) { --i: 5; }
  .td-tabs :global(.td-tab[aria-selected="true"]) { animation: tab-pick 0.5s ease-out; }
  @keyframes tab-pick { from { background: color-mix(in srgb, var(--c) 55%, #0b0b10); } }
  @media (prefers-reduced-motion: reduce) {
    .td-stage :global(.sz-holo), .td-stage :global(.sz-holo > svg), .td-stage :global(.sz-holo::after) { animation: none; }
  }

  @media (max-width: 900px) {
    .td-stage { grid-template-columns: 1fr; }
    .td-stage :global(.td-mapwrap) { min-height: 0; }
    .td-stage :global(.susan) { height: 330px; }
    .td-stage :global(.sz) { width: min(88%, 380px); }
    .td-stage :global(.td-sessions li) { grid-template-columns: auto auto 1fr auto; }
    .td-stage :global(.ts-meta) { grid-column: 1 / -1; }
  }

  /* --- Stats ---------------------------------------------------------------------- */
  .st-body :global(.st-kpis) { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.6rem; }
  .st-body :global(.st-kpi) {
    display: grid; gap: 0.3rem; padding: 0.9rem 1rem; background: #08080b; border: 1px solid #1c1c24; border-top: 3px solid var(--c);
  }
  .st-body :global(.st-kpi span) { font-size: 0.62rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--muted); }
  .st-body :global(.st-kpi b) { color: var(--c); font-size: clamp(1.8rem, 4vw, 2.6rem); line-height: 1; }
  .st-body :global(.st-chart) { margin-top: 1rem; padding: 1rem; background: #08080b; border: 1px solid #1c1c24; }
  .st-body :global(.st-chart-head) { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; flex-wrap: wrap; }
  .st-body :global(.st-chart-head .eyebrow) { margin: 0; }
  .st-body :global(.st-chart-head span), .st-body :global(.st-axis) { font-size: 0.66rem; letter-spacing: 0.16em; color: var(--muted); text-transform: uppercase; }
  .st-body :global(.st-chart svg) { display: block; width: 100%; height: 170px; margin-top: 0.8rem; }
  .st-body :global(.st-chart rect) { fill: color-mix(in srgb, var(--pink) 55%, #1c1c24); }
  .st-body :global(.st-chart rect.best) { fill: var(--purple); }
  .st-body :global(.st-chart rect.today) { fill: var(--green); }
  .st-body :global(.st-chart rect:hover) { fill: #fff; }
  .st-body :global(.st-axis) { display: flex; justify-content: space-between; margin-top: 0.4rem; }
  .st-body :global(.st-cols) { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; margin-top: 1rem; }
  .st-body :global(.st-cols .eyebrow) { margin: 0 0 0.5rem; }
  .st-body :global(.st-list) { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.3rem; }
  .st-body :global(.st-list li) { display: flex; justify-content: space-between; gap: 1rem; padding: 0.5rem 0.8rem; background: #060608; border-left: 3px solid #2a2a33; }
  .st-body :global(.st-list li:first-child) { border-left-color: var(--purple); }
  .st-body :global(.st-list span) { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .st-body :global(.st-list b) { --c: var(--ink); color: var(--ink); }
  .st-body :global(.st-empty) { color: var(--muted); font-size: 0.8rem; margin: 0; }
  @media (max-width: 760px) {
    .st-body :global(.st-kpis) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .st-body :global(.st-cols) { grid-template-columns: 1fr; }
  }

  /* --- Forza-style garage grid ----------------------------------------------------- */
  .fz { margin: 2.2rem 0 3rem; scroll-margin-top: 90px; }
  .fz-head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
  .fz-head .eyebrow { margin: 0; }
  .fz-count { --c: var(--pink); font-size: 1rem; letter-spacing: 0.1em; }
  .fz-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem; } /* cards stretch to fill the row */

  .fz-grid :global(.fz-card) {
    position: relative; display: flex; flex-direction: column; padding: 0; text-align: left; cursor: pointer;
    color: var(--ink); background: linear-gradient(180deg, #111118, #08080b);
    border: 1px solid #1f1f28; border-bottom: 4px solid var(--c);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.35s, border-color 0.25s;
  }
  .fz-grid :global(.fz-card:hover), .fz-grid :global(.fz-card:focus-visible) {
    transform: translateY(-6px); outline: none; border-color: var(--pink);
    box-shadow: 0 0 0 2px var(--pink), 0 24px 50px -20px rgba(255, 43, 214, 0.6);
  }
  .fz-grid :global(.fz-card.on) {
    border-color: var(--pink); box-shadow: 0 0 0 3px var(--pink), 0 0 40px -6px rgba(255, 43, 214, 0.55);
  }

  /* photo */
  .fz-grid :global(.fz-photo) { position: relative; display: block; aspect-ratio: 16 / 10; overflow: hidden; background: #060608; }
  .fz-grid :global(.fz-photo img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease; }
  .fz-grid :global(.fz-photo img.cover) { object-position: 50% 66%; } /* tall trackside covers: keep the vehicle in frame */
  .fz-grid :global(.fz-card:hover .fz-photo img) { transform: scale(1.06); }
  .fz-grid :global(.fz-photo::after) { content: ''; position: absolute; inset: 0; background: linear-gradient(transparent 55%, rgba(0, 0, 0, 0.6)); }
  .fz-grid :global(.fz-ph) {
    position: absolute; inset: 0; display: grid; place-items: center; font-size: clamp(2rem, 4vw, 3rem); font-style: italic;
    color: transparent; -webkit-text-stroke: 1.5px var(--c);
    background: radial-gradient(60% 70% at 50% 50%, color-mix(in srgb, var(--c) 16%, transparent), transparent 70%);
  }
  .fz-grid :global(.fz-sold) {
    position: absolute; z-index: 2; top: 0.7rem; left: -0.3rem; padding: 0.25rem 0.9rem 0.25rem 0.7rem;
    font-family: var(--display); font-weight: 900; font-style: italic; letter-spacing: 0.08em; color: #fff; background: var(--f1red);
    clip-path: polygon(0 0, 100% 0, calc(100% - 8px) 100%, 0 100%);
  }
  /* Forza performance-class badge: coloured letter + PI number */
  .fz-grid :global(.fz-class) {
    position: absolute; z-index: 2; top: 0.7rem; right: 0.7rem; display: flex; align-items: stretch;
    font-family: var(--display); font-weight: 900; font-style: normal; box-shadow: 0 6px 16px rgba(0, 0, 0, 0.5);
  }
  .fz-grid :global(.fz-class b) { padding: 0.15rem 0.45rem; background: var(--k); color: #000; font-size: 0.95rem; }
  .fz-grid :global(.fz-class em) { padding: 0.15rem 0.5rem; background: #f4f4f6; color: #000; font-style: normal; font-size: 0.95rem; }

  /* text */
  .fz-grid :global(.fz-body) { display: grid; gap: 0.3rem; padding: 0.9rem 1rem 0.6rem; }
  .fz-grid :global(.fz-make) { font-size: 0.66rem; letter-spacing: 0.24em; text-transform: uppercase; color: var(--muted); }
  .fz-grid :global(.fz-model) { font-size: 1.55rem; font-style: italic; text-transform: uppercase; line-height: 1; }
  .fz-grid :global(.fz-status) { font-size: 0.68rem; letter-spacing: 0.16em; text-transform: uppercase; color: #b9b9c4; }
  .fz-grid :global(.fz-status i) { display: inline-block; width: 7px; height: 7px; border-radius: 50%; margin-right: 0.45rem; }
  .fz-grid :global(.fz-stats) { display: grid; gap: 0.35rem; margin-top: 0.4rem; }
  .fz-grid :global(.fz-stats > span) { display: grid; grid-template-columns: 5.6rem 1fr; align-items: center; gap: 0.6rem; }
  .fz-grid :global(.fz-stats em) { font-style: normal; font-family: var(--mono); font-size: 0.58rem; letter-spacing: 0.2em; color: var(--muted); }
  .fz-grid :global(.fz-bar) { display: block; height: 5px; background: #1a1a21; overflow: hidden; }
  .fz-grid :global(.fz-bar i) { display: block; height: 100%; width: calc(var(--v) * 100%); background: var(--c); transition: width 0.6s cubic-bezier(0.16, 1, 0.3, 1); }
  .fz-grid :global(.fz-cta) {
    margin: 0.4rem 1rem 0.9rem; align-self: flex-start; padding: 0.35rem 0.8rem;
    font-family: var(--display); font-weight: 700; font-style: italic; font-size: 0.8rem; letter-spacing: 0.06em; text-transform: uppercase;
    color: #000; background: var(--ink); clip-path: polygon(6px 0, 100% 0, calc(100% - 6px) 100%, 0 100%);
  }
  .fz-grid :global(.fz-card:hover .fz-cta), .fz-grid :global(.fz-card.on .fz-cta) { background: var(--pink); color: #fff; }

  /* only the chosen vehicle's card is shown */
  .builds :global(.build[hidden]) { display: none; }
  .builds :global(.build.arrive) { animation: arrive 0.7s cubic-bezier(0.16, 1, 0.3, 1); }
  @keyframes arrive { from { opacity: 0; transform: translateY(40px) scale(0.98); } }
  .builds :global(.sel-back) {
    grid-column: 1 / -1; justify-self: end; margin: 0; padding: 0.5rem 1rem; border: 0; cursor: pointer;
    background: none; color: var(--muted); font-family: var(--mono); font-size: 0.7rem; letter-spacing: 0.2em; text-transform: uppercase;
  }
  .builds :global(.sel-back:hover) { color: var(--c); }

  /* LED sign: full-width trackside screen across the top of every vehicle card */
  .builds :global(.b-sign) {
    grid-column: 1 / -1; padding: 0.55rem 0.7rem; background: #030304;
    border-bottom: 1px solid color-mix(in srgb, var(--c) 35%, #1c1c24);
    box-shadow: inset 0 -30px 60px -40px color-mix(in srgb, var(--c) 45%, transparent);
  }
  .builds :global(.b-sign canvas) {
    display: block; width: 100%; aspect-ratio: 200 / 11; border-radius: 3px;
    box-shadow: 0 0 0 1px #1b1b22, 0 0 40px -12px color-mix(in srgb, var(--c) 45%, transparent);
  }
  /* no photos yet: a clean placeholder in the photo slot */
  .builds :global(.b-empty) {
    position: absolute; inset: 0; display: grid; place-content: center; justify-items: center; gap: 0.6rem;
    background:
      radial-gradient(60% 60% at 50% 50%, color-mix(in srgb, var(--c) 14%, transparent), transparent 70%),
      repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.025) 0 1px, transparent 1px 14px), #060608;
  }
  .builds :global(.b-empty span) {
    font-size: clamp(3rem, 7vw, 5.5rem); font-style: italic; line-height: 1;
    color: transparent; -webkit-text-stroke: 1.5px color-mix(in srgb, var(--c) 70%, transparent);
  }
  .builds :global(.b-empty em) { font-style: normal; font-size: 0.72rem; letter-spacing: 0.24em; text-transform: uppercase; color: var(--muted); }

  /* SOLD: race-control style banner across the top of the photo frame */
  .builds :global(.sold-banner) {
    position: absolute; z-index: 6; top: 0; left: 0; right: 0;
    display: flex; align-items: center; gap: 1rem; padding: 0.7rem 1.1rem;
    background:
      repeating-linear-gradient(135deg, rgba(0, 0, 0, 0.35) 0 12px, transparent 12px 24px),
      linear-gradient(90deg, #b30000, #e10600 60%, #ff2a1a);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.55);
    border-bottom: 3px solid #fff;
  }
  .builds :global(.sold-banner span) {
    --c: #fff; font-size: 1.7rem; line-height: 1; letter-spacing: 0.16em;
    padding: 0.15rem 0.6rem; background: rgba(0, 0, 0, 0.55);
  }
  .builds :global(.sold-banner em) {
    font-style: italic; font-family: var(--display); font-weight: 700; font-size: 0.85rem;
    letter-spacing: 0.06em; text-transform: uppercase; color: #fff;
  }

  /* rider's notes: collapsed to a few lines, fades out until expanded */
  .builds :global(.review) { border-left: 3px solid var(--c); padding: 0.2rem 0 0.2rem 1rem; }
  .builds :global(.review .eyebrow) { margin: 0 0 0.6rem; }
  .builds :global(.rv-body) {
    max-height: 7.6em; overflow: hidden; color: #d0d0d8; font-size: 0.97rem; line-height: 1.6;
    -webkit-mask-image: linear-gradient(#000 55%, transparent); mask-image: linear-gradient(#000 55%, transparent);
    transition: max-height 0.5s ease;
  }
  .builds :global(.review.open .rv-body) { max-height: 60em; -webkit-mask-image: none; mask-image: none; }
  .builds :global(.rv-body p) { margin: 0 0 0.8rem; }
  .builds :global(.rv-body p:first-child) { font-size: 1.04rem; color: var(--ink); }
  .builds :global(.rv-toggle) {
    margin-top: 0.3rem; padding: 0; border: 0; background: none; cursor: pointer;
    font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--c);
  }
  .builds :global(.rv-toggle:hover) { text-decoration: underline; }

  /* build log as timing-board rows — scrolls inside the card so it never spills out */
  .builds :global(.log) {
    list-style: none; margin: 0; padding: 0 0.3rem 0 0; display: grid; gap: 0.35rem; align-content: start;
    max-height: 21rem; overflow-y: auto; scrollbar-width: thin; scrollbar-color: var(--c) #0a0a0d;
  }
  .builds :global(.log li) {
    display: grid; grid-template-columns: auto 1fr auto; gap: 1rem; align-items: baseline;
    padding: 0.65rem 0.6rem 0.65rem 0.9rem; background: #060608; border-left: 3px solid var(--c);
  }
  .builds :global(.log li:first-child) { background: color-mix(in srgb, var(--c) 9%, #060608); }
  .builds :global(.log li.empty) { grid-template-columns: 1fr; border-left-style: dashed; }
  .builds :global(.log .d) { --c: var(--amber); font-size: 0.95rem; white-space: nowrap; }
  .builds :global(.log .d em) { font-style: normal; margin-left: 0.6rem; opacity: 0.7; }
  .builds :global(.log .n) { color: #d0d0d8; font-size: 0.95rem; overflow-wrap: anywhere; }
  .builds :global(.del) {
    border: 0; background: none; cursor: pointer; color: #4a4a55; font-family: var(--mono); font-size: 0.75rem;
    padding: 0.1rem 0.3rem; opacity: 0; transition: opacity 0.2s, color 0.2s;
  }
  .builds :global(.log li:hover .del), .builds :global(.del:focus-visible), .builds :global(.del.armed) { opacity: 1; }
  .builds :global(.del:hover) { color: var(--ink); }
  .builds :global(.del.armed) { color: #fff; background: var(--f1red); letter-spacing: 0.08em; }
  @media (hover: none) { .builds :global(.del) { opacity: 1; } }

  .builds :global(.log-bar) { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: 0.4rem; }
  .builds :global(.log-head) { margin: 0; }
  .builds :global(.add-btn), .td-stage :global(.add-btn) {
    font-family: var(--display); font-weight: 700; font-style: italic; font-size: 0.82rem; letter-spacing: 0.06em; text-transform: uppercase;
    padding: 0.45rem 0.95rem; border: 0; cursor: pointer; color: #000; background: var(--c);
    clip-path: polygon(8px 0, 100% 0, calc(100% - 8px) 100%, 0 100%); transition: transform 0.2s, filter 0.2s;
  }
  .builds :global(.add-btn:hover), .td-stage :global(.add-btn:hover) { transform: translateX(3px); filter: brightness(1.15); }

  /* inline add-log form */
  .builds :global(.log-form) {
    display: grid; gap: 0.5rem; padding: 0.8rem; background: #050507;
    border: 1px solid color-mix(in srgb, var(--c) 45%, #1c1c24); animation: form-in 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .builds :global(.log-form[hidden]) { display: none; }
  @keyframes form-in { from { opacity: 0; transform: translateY(-8px); } }
  .builds :global(.log-form input), .builds :global(.log-form textarea) {
    width: 100%; padding: 0.65rem 0.8rem; font-family: var(--mono); font-size: 0.92rem; color: var(--lime);
    caret-color: var(--lime); background: #030304; border: 1px solid #1f1f28; color-scheme: dark;
  }
  .builds :global(.log-form textarea) { resize: vertical; }
  .builds :global(.log-form input:focus), .builds :global(.log-form textarea:focus) { outline: none; border-color: var(--lime); }
  .builds :global(.lf-actions), .td-stage :global(.lf-actions) { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
  .builds :global(.lf-actions .btn), .td-stage :global(.lf-actions .btn) { padding: 0.55rem 1.1rem; font-size: 0.82rem; }
  .builds :global(.lf-msg), .td-stage :global(.lf-msg) { --c: var(--amber); font-size: 0.9rem; margin-left: auto; }

  @media (max-width: 900px) {
    .builds :global(.build) { grid-template-columns: 1fr; }
    .builds :global(.build:nth-child(even) .b-media) { order: 0; }
    .builds :global(.b-media) { min-height: 300px; }
  }
  @media (max-width: 620px) {
    .auth { flex-direction: column; }
    .builds :global(.tiles) { grid-template-columns: 1fr 1fr; }
    .builds :global(.log li) { grid-template-columns: 1fr; gap: 0.2rem; }
  }
  /* --- Forza-style screens: GARAGE <-> TRACK DAY ------------------------------- */
  .fzm { position: relative; display: flex; align-items: center; gap: clamp(0.9rem, 3vw, 2rem); margin: 1.6rem 0 0.9rem; }
  .fzm-tab {
    padding: 0.2rem 0; background: none; border: 0; cursor: pointer; color: var(--muted);
    font-family: var(--display); font-style: italic; font-weight: 900; text-transform: uppercase;
    font-size: clamp(1.25rem, 3.2vw, 2.1rem); letter-spacing: 0.02em; line-height: 1; transition: color 0.25s;
  }
  .fzm-tab:hover { color: #c9c9d2; }
  .fzm-tab[aria-selected='true'] { color: var(--ink); text-shadow: 0 0 22px rgba(255, 43, 214, 0.45); }
  .fzm-tab:focus-visible { outline: 2px solid var(--pink); outline-offset: 4px; }
  .fzm-key {
    display: grid; place-items: center; min-width: 1.7rem; height: 1.7rem; padding: 0 0.35rem;
    font-size: 0.8rem; color: var(--muted); border: 1px solid #2c2c36; border-radius: 4px; background: #0b0b10;
  }
  .fzm-ink {
    position: absolute; left: 0; bottom: -0.55rem; width: 0; height: 4px; background: var(--pink);
    transform: skewX(-24deg); box-shadow: 0 0 14px rgba(255, 43, 214, 0.8);
    transition: left 0.5s cubic-bezier(0.7, 0, 0.2, 1), width 0.5s cubic-bezier(0.7, 0, 0.2, 1);
  }
  @media (pointer: coarse) { .fzm-key { display: none; } }

  .pane { will-change: transform, opacity; }
  .pane.out-fwd  { animation: pane-out 0.3s cubic-bezier(0.55, 0, 0.8, 0.3) forwards; --dx: -9%; }
  .pane.out-back { animation: pane-out 0.3s cubic-bezier(0.55, 0, 0.8, 0.3) forwards; --dx: 9%; }
  .pane.in-fwd   { animation: pane-in 0.5s cubic-bezier(0.15, 0.85, 0.25, 1) both; --dx: 11%; }
  .pane.in-back  { animation: pane-in 0.5s cubic-bezier(0.15, 0.85, 0.25, 1) both; --dx: -11%; }
  @keyframes pane-out { to { transform: translateX(var(--dx)) skewX(-7deg); opacity: 0; filter: blur(6px); } }
  @keyframes pane-in  { from { transform: translateX(var(--dx)) skewX(-7deg); opacity: 0; filter: blur(6px); } }

  /* the diagonal slash that sweeps the screen (covers the swap at its midpoint) */
  .slash { position: fixed; inset: 0; z-index: 60; pointer-events: none; overflow: hidden; visibility: hidden; }
  .slash::before, .slash::after, .slash span { position: absolute; top: -10%; bottom: -10%; left: 0; }
  .slash::before {
    content: ''; width: 140vw;
    background:
      repeating-linear-gradient(-70deg, transparent 0 46px, rgba(255, 255, 255, 0.07) 46px 50px),
      linear-gradient(100deg, #ff2bd6, #b14cff 55%, #ff2bd6);
  }
  .slash::after { content: ''; width: 3vw; background: var(--lime); box-shadow: 0 0 30px var(--lime); }
  .slash span {
    width: 140vw; display: grid; place-items: center; color: #fff; white-space: nowrap;
    font-family: var(--display); font-style: italic; font-weight: 900; text-transform: uppercase;
    font-size: clamp(3rem, 12vw, 10rem); letter-spacing: -0.02em; text-shadow: 0 6px 0 rgba(0, 0, 0, 0.25);
  }
  .slash.fwd, .slash.back { visibility: visible; }
  .slash.fwd::before, .slash.fwd span  { animation: slash-fwd 0.66s cubic-bezier(0.75, 0, 0.25, 1) both; }
  .slash.fwd::after                    { animation: slash-fwd-edge 0.66s cubic-bezier(0.75, 0, 0.25, 1) both; }
  .slash.back::before, .slash.back span { animation: slash-back 0.66s cubic-bezier(0.75, 0, 0.25, 1) both; }
  .slash.back::after                    { animation: slash-back-edge 0.66s cubic-bezier(0.75, 0, 0.25, 1) both; }
  @keyframes slash-fwd  { from { transform: translateX(100vw) skewX(-18deg); } to { transform: translateX(-140vw) skewX(-18deg); } }
  @keyframes slash-back { from { transform: translateX(-140vw) skewX(-18deg); } to { transform: translateX(100vw) skewX(-18deg); } }
  /* lime edge rides just ahead of the band */
  @keyframes slash-fwd-edge  { from { transform: translateX(96vw) skewX(-18deg); } to { transform: translateX(-144vw) skewX(-18deg); } }
  @keyframes slash-back-edge { from { transform: translateX(0vw) skewX(-18deg); } to { transform: translateX(240vw) skewX(-18deg); } }

  /* edge arrows */
  .edge {
    position: fixed; top: 50%; z-index: 30; display: flex; align-items: center; gap: 0.6rem;
    padding: 1rem 1.3rem; border: 0; cursor: pointer; color: #fff; background: var(--pink);
    font-family: var(--display); font-style: italic; font-weight: 900; text-transform: uppercase; font-size: 1rem;
    letter-spacing: 0.04em; box-shadow: 0 0 30px -4px rgba(255, 43, 214, 0.7); transition: padding 0.25s, filter 0.25s;
  }
  .edge b { font-size: 1.5rem; line-height: 0.6; }
  /* desktop: slim vertical tabs that live in the side margin */
  .edge-next, .edge-prev { writing-mode: vertical-rl; padding: 1.4rem 0.75rem; transform: translateY(-50%); }
  .edge-next { right: 0; clip-path: polygon(0 12px, 100% 0, 100% 100%, 0 calc(100% - 12px)); }
  .edge-prev { left: 0; clip-path: polygon(0 0, 100% 12px, 100% calc(100% - 12px), 0 100%); }
  .edge-prev span { transform: rotate(180deg); }
  .edge-prev b { order: -1; }
  .edge-next:hover { padding-right: 1.05rem; filter: brightness(1.15); }
  .edge-prev:hover { padding-left: 1.05rem; filter: brightness(1.15); }
  .edge-next b, .edge-prev b { writing-mode: horizontal-tb; }
  .edge-next b { animation: nudge-r 1.4s ease-in-out infinite; }
  .edge-prev b { animation: nudge-l 1.4s ease-in-out infinite; }
  @keyframes nudge-r { 50% { transform: translateX(5px); } }
  @keyframes nudge-l { 50% { transform: translateX(-5px); } }
  .edge[hidden] { display: none; }
  @media (max-width: 1240px) {
    /* phones/tablets: compact pills at the bottom so they never cover the content column */
    .edge, .edge-next, .edge-prev { writing-mode: horizontal-tb; top: auto; bottom: 14px; transform: none; padding: 0.7rem 1rem; font-size: 0.85rem; }
    .edge-prev span { transform: none; }
    .edge b { font-size: 1.3rem; }
    .edge-next { right: 12px; clip-path: polygon(10px 0, 100% 0, calc(100% - 10px) 100%, 0 100%); padding-left: 1.2rem; }
    .edge-prev { left: 12px; clip-path: polygon(10px 0, 100% 0, calc(100% - 10px) 100%, 0 100%); padding-right: 1.2rem; }
    .edge-next:hover, .edge-prev:hover { padding: 0.7rem 1rem 0.7rem 1.2rem; }
  }
  @media (prefers-reduced-motion: reduce) { .edge b { animation: none; } }
</style>

<script>
  import { API_BASE } from '../lib/api';
  import { initBoard } from '../scripts/ledboard';
  import { scrollFx } from '../scripts/scrollfx';
  import { smoothScroll } from '../scripts/smoothscroll';
  import { swipeable } from '../scripts/swipe';
  import { spinner } from '../scripts/spin';
  import { OWNER_KEY } from '../scripts/track';

  type Photo = { src: string; caption?: string };
  type LogItem = { date: string; time?: string; note: string };
  type Build = {
    id: string; tag: string; color: string; scene: string; name: string;
    chassis?: string; status?: string; power?: string; log?: LogItem[];
    review?: { title?: string; body: string[] }; // optional write-up shown under the specs
    sold?: boolean;  // shows a SOLD banner over the photos
    short?: string;  // shorter tag for the LED board (max ~7 chars)
  };

  const KEY = 'garage_token';
  const gate = document.getElementById('gate')!;
  const content = document.getElementById('content')!;
  const err = document.getElementById('auth-err')!;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const esc = (s: unknown) => String(s ?? '').replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);

  smoothScroll();

  // lock-screen LED board
  const gb = document.getElementById('gate-board') as HTMLCanvasElement;
  initBoard(gb, [{ scene: 'track', tag: 'CREW', color: '#ff1e2d', line: 'AUTHORISED CREW ONLY * PIT LANE ACCESS * ENTER CODE', sub: 'PIT LANE' }]).show(0);

  async function loadGarage(token: string, keepScroll = false): Promise<boolean> {
    const res = await fetch(`${API_BASE}/api/garage`, { headers: { Authorization: `Bearer ${token}` } });
    if (!res.ok) return false;
    const data: { builds: Build[]; trackday?: TrackDay } = await res.json();
    const photos: Record<string, Photo[]> =
      await fetch('/work/photos.json', { cache: 'no-store' }).then((r) => (r.ok ? r.json() : {})).catch(() => ({}));
    render(data.builds ?? [], photos);
    renderTrackday(data.trackday, data.builds ?? []);
    gate.hidden = true;
    content.hidden = false;
    try { localStorage.setItem(OWNER_KEY, '1'); } catch { /* storage blocked */ }
    if (!keepScroll) { window.scrollTo({ top: 0 }); setPane(paneFromHash(), false); }
    return true;
  }

  // --- Forza-style garage grid ------------------------------------------------------
  let selectedId = ''; // vehicle whose card is shown below ('' = none yet)

  const hp = (b: Build) => Number((b.power ?? '').match(/(\d+)\s*hp/i)?.[1] ?? 0);
  const lampOf = (b: Build) => (b.sold ? 'var(--f1red)' : /run|done|complete/i.test(b.status ?? '') ? 'var(--green)' : 'var(--amber)');
  // Forza-style performance class, derived from horsepower (just for fun)
  function perfClass(b: Build): { cls: string; pi: string; color: string } {
    const h = hp(b);
    if (!h) return { cls: '?', pi: '---', color: '#5a5a66' };
    const pi = Math.min(999, Math.round(100 + h * 8));
    const [cls, color] =
      pi > 900 ? ['S2', '#3d7bff'] : pi > 800 ? ['S1', '#b14cff'] : pi > 700 ? ['A', '#ff2a1a']
      : pi > 600 ? ['B', '#ff7a1a'] : pi > 500 ? ['C', '#ffd400'] : ['D', '#39c5ff'];
    return { cls, pi: String(pi), color };
  }

  function setupSelect(builds: Build[], photos: Record<string, Photo[]>) {
    document.getElementById('fz-count')!.textContent = `${String(builds.length).padStart(2, '0')} VEHICLES`;
    const grid = document.getElementById('fz-grid')!;
    grid.innerHTML = builds.map((b) => {
      // card cover: photos/<id>/cover.jpg if there is one, else the first photo's thumbnail
      const cover = (photos as unknown as { _covers?: Record<string, string> })._covers?.[b.id];
      const first = photos[b.id]?.[0];
      const img = cover ?? first?.src.replace(/\.jpg$/, '-t.jpg');
      const pc = perfClass(b);
      const [make, ...model] = b.name.split(' ');
      const year = /^\d{4}$/.test(b.chassis ?? '') ? b.chassis : '';
      const stats: [string, number][] = [
        ['POWER', Math.min(1, hp(b) / 100)],
        ['BUILD LOG', Math.min(1, (b.log?.length ?? 0) / 10)],
      ];
      return `
        <button class="fz-card${b.id === selectedId ? ' on' : ''}" type="button" data-pick="${esc(b.id)}" style="--c: ${esc(b.color)}" aria-pressed="${b.id === selectedId}">
          <span class="fz-photo">${img ? `<img src="${esc(img)}"${cover ? ' class="cover"' : ''} alt="" loading="lazy" />` : `<span class="fz-ph display">${esc(b.tag)}</span>`}
            ${b.sold ? '<span class="fz-sold">SOLD</span>' : ''}
            <span class="fz-class" style="--k: ${pc.color}"><b>${pc.cls}</b><em>${pc.pi}</em></span>
          </span>
          <span class="fz-body">
            <span class="fz-make mono">${esc(make)}${year ? ` · ${esc(year)}` : ''}</span>
            <span class="fz-model display">${esc(model.join(' ') || b.name)}</span>
            <span class="fz-status mono"><i style="background: ${lampOf(b)}"></i>${esc(b.status ?? '')}</span>
            <span class="fz-stats">${stats.map(([k, v]) => `<span><em>${k}</em><span class="fz-bar"><i style="--v: ${v}"></i></span></span>`).join('')}</span>
          </span>
          <span class="fz-cta">${b.id === selectedId ? 'Selected ✓' : 'Open ▸'}</span>
        </button>`;
    }).join('');
  }

  /** Show only the chosen vehicle's card and bring it into view. */
  function choose(id: string) {
    selectedId = id;
    document.querySelectorAll<HTMLElement>('.build').forEach((c) => { c.hidden = c.id !== `build-${id}`; });
    document.querySelectorAll<HTMLElement>('.fz-card').forEach((c) => {
      const on = c.dataset.pick === id;
      c.classList.toggle('on', on); c.setAttribute('aria-pressed', String(on));
      c.querySelector('.fz-cta')!.textContent = on ? 'Selected ✓' : 'Open ▸';
    });
    const card = document.getElementById(`build-${id}`);
    if (card) {
      card.classList.remove('arrive'); void card.offsetWidth; card.classList.add('arrive');
      card.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'start' });
      window.dispatchEvent(new Event('scroll')); // let scroll animations measure the newly shown card
    }
  }

  // one listener for the grid (survives re-renders)
  document.getElementById('fz-grid')!.addEventListener('click', (e) => {
    const card = (e.target as HTMLElement).closest<HTMLElement>('[data-pick]');
    if (card) choose(card.dataset.pick!);
  });

  function render(builds: Build[], photos: Record<string, Photo[]>) {
    const wrap = document.getElementById('builds')!;
    wrap.innerHTML = builds.map((b) => {
      const ph = (photos[b.id] ?? []).slice(0, 7); // private page: up to 7 per build
      const media = ph.length
        ? ph.map((p, j) => `<figure class="b-slide${j === 0 ? ' on' : ''}" data-cap="${esc(p.caption)}"><img src="${esc(p.src)}" alt="${esc(p.caption)}" loading="lazy" /></figure>`).join('')
          + `<span class="b-cap">${esc(ph[0].caption)}</span>`
        : `<div class="b-empty"><span class="display">${esc(b.short ?? b.tag)}</span><em class="mono">Photos coming soon</em></div>`;
      const running = /run|done|complete/i.test(b.status ?? '');
      const stamp = (e: LogItem) => `${e.date} ${e.time ?? ''}`;
      const log = [...(b.log ?? [])].sort((x, y) => stamp(y).localeCompare(stamp(x))); // newest first
      return `
        <article class="build" id="build-${esc(b.id)}" style="--c: ${esc(b.color)}"${b.id === selectedId ? '' : ' hidden'}>
          <button class="sel-back" type="button" data-back>▲ Change vehicle</button>
          <div class="b-sign" data-fx="rise"><canvas data-build="${esc(b.id)}" role="img" aria-label="${esc(b.name)} — ${esc(b.status)}"></canvas></div>
          <div class="b-media" data-fx="wipe">${media}${b.sold ? `<div class="sold-banner" role="note"><span class="lcd-text">SOLD</span><em>Former build — moved on to the next one</em></div>` : ''}</div>
          <div class="b-body">
            <div class="b-top" data-fx="rise" data-d="150">
              <span class="b-tag">${esc(b.tag)}</span>
              <span class="b-status lcd-text" style="--c: var(${b.sold ? '--f1red' : running ? '--green' : '--amber'})"><i></i>${esc(b.status)}</span>
            </div>
            <h2 class="display" data-fx="left" data-d="220">${esc(b.name)}</h2>
            <div class="tiles" data-fx="rise" data-d="300">
              <div class="tile lcd"><span>CHASSIS</span><b class="lcd-text">${esc(b.chassis || '—')}</b></div>
              <div class="tile lcd"><span>POWER</span><b class="lcd-text">${esc(b.power || '—')}</b></div>
              <div class="tile lcd"><span>LOG ENTRIES</span><b class="lcd-text">${String(log.length).padStart(2, '0')}</b></div>
            </div>
            ${b.review?.body?.length ? `
            <div class="review" data-fx="rise" data-d="330">
              <p class="eyebrow">Rider's notes${b.review.title ? ` — ${esc(b.review.title)}` : ''}</p>
              <div class="rv-body">${b.review.body.map((para) => `<p>${esc(para)}</p>`).join('')}</div>
              ${b.review.body.length > 1 ? `<button class="rv-toggle" type="button" data-review>Read full review ▸</button>` : ''}
            </div>` : ''}
            <div class="log-bar" data-fx="rise" data-d="360">
              <p class="eyebrow log-head">Build log — latest first</p>
              <button class="add-btn" type="button" data-add="${esc(b.id)}">+ Add log</button>
            </div>
            <form class="log-form" data-build="${esc(b.id)}" hidden>
              <input name="when" type="datetime-local" required />
              <textarea name="note" rows="2" maxlength="600" placeholder="What did you do to it?" required></textarea>
              <div class="lf-actions">
                <button class="btn btn-primary" type="submit">Save ▸</button>
                <button class="btn" type="button" data-cancel>Cancel</button>
                <span class="lf-msg lcd-text"></span>
              </div>
            </form>
            <ol class="log" data-native-scroll>${log.length ? log.map((e, j) => `
              <li data-fx="rise" data-d="${400 + Math.min(j, 5) * 80}">
                <span class="d lcd-text">${esc(e.date)}${e.time ? `<em>${esc(e.time)}</em>` : ''}</span>
                <span class="n">${esc(e.note)}</span>
                <button class="del" type="button" title="Delete entry" aria-label="Delete entry"
                  data-del="${esc(b.id)}" data-date="${esc(e.date)}" data-time="${esc(e.time ?? '')}" data-note="${esc(e.note)}">✕</button>
              </li>`).join('') : '<li class="empty"><span class="n">No entries yet — add the first one.</span></li>'}
            </ol>
          </div>
        </article>`;
    }).join('');

    // LED sign on top of every vehicle: pixel art, name, chassis, scrolling status + specs
    wrap.querySelectorAll<HTMLCanvasElement>('canvas[data-build]').forEach((cv) => {
      const b = builds.find((x) => x.id === cv.dataset.build);
      if (b) initBoard(cv, [{
        scene: b.scene, tag: b.tag, color: b.color,
        light: b.sold ? 'red' : /run|done|complete/i.test(b.status ?? '') ? 'green' : 'amber',
        line: [b.name, b.chassis && `CHASSIS ${b.chassis}`, b.status, b.power, b.log?.length ? `${b.log.length} LOG ENTRIES` : ''].filter(Boolean).join(' * ').toUpperCase(),
      }], undefined, { banner: true }).show(0);
    });

    // photo slides: diagonal wipe every 5s; swipe / drag sideways to flip through
    wrap.querySelectorAll<HTMLElement>('.b-media').forEach((m) => {
      const slides = Array.from(m.querySelectorAll<HTMLElement>('.b-slide'));
      const cap = m.querySelector('.b-cap');
      if (slides.length < 2) return;
      let at = 0, touched = 0;
      const go = (i: number, dir: 1 | -1 = 1) => {
        const from = at; at = (i + slides.length) % slides.length;
        m.classList.toggle('rev', dir < 0); void m.offsetWidth;
        slides.forEach((s, j) => { s.classList.toggle('prev', j === from); s.classList.toggle('on', j === at); });
        if (cap) cap.textContent = slides[at].dataset.cap ?? '';
      };
      swipeable(m, (dir) => { touched = Date.now(); go(at + dir, dir); });
      if (!reduced) setInterval(() => { if (Date.now() - touched > 6000) go(at + 1); }, 5000);
    });

    setupSelect(builds, photos);
    scrollFx(wrap);
  }

  // --- TRACK DAY -------------------------------------------------------------------
  type Track = {
    id: string; name: string; alias?: string; kind?: string; location?: string;
    length_km?: number; turns?: number; status: 'active' | 'planned'; map?: string; color: string;
  };
  type Session = { track: string; date: string; vehicle?: string; best: string; notes?: string };
  type TrackDay = { tracks: Track[]; sessions: Session[] };

  // drawn layouts (viewBox 0 0 1000 620). Only real, known layouts live here —
  // tracks without one show "trace pending" until a GPS session provides the line.
  const MAPS: Record<string, { d: string; start: [number, number]; labels: [string, number, number][] }> = {
    sepang: {
      d: 'M 230 430 L 700 430 C 760 430 790 470 760 505 C 735 535 690 520 690 560 C 690 610 780 615 850 580 C 920 545 930 470 880 430 L 860 400 C 835 380 845 340 880 330 C 930 315 940 240 890 205 C 850 180 820 210 780 190 C 740 170 760 120 710 105 C 660 90 610 120 600 160 C 590 200 540 215 500 190 C 460 165 430 120 380 120 C 320 120 300 175 330 210 C 360 245 420 240 440 280 C 455 320 420 345 380 345 L 150 345 C 80 345 70 430 150 430 Z',
      start: [230, 430],
      labels: [['T1', 772, 470], ['T15', 60, 395], ['BACK STRAIGHT', 175, 335]],
    },
  };

  const lapSecs = (t: string) => {
    const [m, s] = t.includes(':') ? t.split(':') : ['0', t];
    return Number(m) * 60 + Number(s);
  };
  const fmtDelta = (d: number) => (d === 0 ? 'PB' : `+${d.toFixed(3)}`);

  let tdData: TrackDay | null = null;
  let tdBuilds: Build[] = [];
  let tdSel = '';
  let ghostRaf = 0;

  function renderTrackday(td: TrackDay | undefined, builds: Build[]) {
    if (!td) return;
    // a planned track counts as ridden as soon as it has a session
    td.tracks.forEach((t) => { if (td.sessions.some((s) => s.track === t.id)) t.status = 'active'; });
    tdData = td; tdBuilds = builds;
    if (!tdSel || !td.tracks.some((t) => t.id === tdSel)) tdSel = td.tracks[0]?.id ?? '';
    const ridden = td.tracks.filter((t) => t.status === 'active').length;
    document.getElementById('td-count')!.textContent = `${String(ridden).padStart(2, '0')} TRACKS · ${String(td.sessions.length).padStart(2, '0')} SESSIONS`;
    document.getElementById('td-tabs')!.innerHTML = td.tracks.map((t) => {
      const best = bestOf(t.id);
      return `<button class="td-tab" type="button" role="tab" data-track="${esc(t.id)}" style="--c: ${esc(t.color)}" aria-selected="${t.id === tdSel}">
        <span class="tt-name">${esc(t.alias ? `${t.name} · ${t.alias}` : t.name)}</span>
        <span class="tt-sub mono">${t.status === 'planned' ? 'UPCOMING' : best ? `PB ${esc(best.best)}` : 'NO LAPS YET'}</span>
      </button>`;
    }).join('');
    buildCarousel(td);
    showTrack(tdSel);
  }

  // --- lazy-susan carousel ---------------------------------------------------------
  // track i rides at angle a + i*step on the orbit; it's at the front when a = -i*step
  const stepDeg = () => 360 / Math.max(1, tdData?.tracks.length ?? 1);
  const frontAngle = (i: number, from: number) => {
    const want = -i * stepDeg();
    return want + Math.round((from - want) / 360) * 360; // shortest way round
  };

  function buildCarousel(td: TrackDay) {
    const stage = document.getElementById('td-stage')!;
    stage.innerHTML = `
      <div class="td-mapwrap">
        <div class="susan" title="Drag to spin">
          <svg class="orbit" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
            <ellipse cx="50" cy="50" rx="50" ry="50" class="o-glow"/><ellipse cx="50" cy="50" rx="50" ry="50" class="o-line"/>
          </svg>
          ${td.tracks.map((t) => `
            <div class="sz" data-track="${esc(t.id)}" style="--c: ${esc(t.color)}">
              <div class="sz-holo">${mapSvg(t)}</div>
              <span class="sz-tag mono">${esc(t.alias ?? t.name)}</span>
            </div>`).join('')}
        </div>
        <span class="td-hud mono"></span>
        <span class="hud-hint mono">◂ DRAG TO SPIN ▸</span>
      </div>
      <div class="td-info"></div>`;
    const i = td.tracks.findIndex((t) => t.id === tdSel);
    trackSpin.to(frontAngle(Math.max(0, i), trackSpin.angle), 0);
  }

  function placeCarousel(a: number) {
    const box = tdStage.querySelector<HTMLElement>('.susan');
    if (!box) return;
    const rx = box.clientWidth * 0.34, ry = box.clientHeight * 0.15, step = stepDeg();
    box.querySelectorAll<HTMLElement>('.sz').forEach((el, i) => {
      const th = ((a + i * step) * Math.PI) / 180;
      const f = (Math.cos(th) + 1) / 2; // 1 = front, 0 = back
      el.style.transform = `translate(-50%, -88%) translate(${(Math.sin(th) * rx).toFixed(1)}px, ${(Math.cos(th) * ry).toFixed(1)}px) scale(${(0.5 + 0.5 * f).toFixed(3)})`;
      el.style.opacity = (0.38 + 0.62 * f * f).toFixed(3);
      el.style.zIndex = String(Math.round(f * 100));
      el.style.filter = f > 0.93 ? '' : `blur(${((1 - f) * 1.2).toFixed(2)}px)`;
    });
    // the orbit's dashes travel with the spin
    box.querySelector('.o-line')?.setAttribute('stroke-dashoffset', (a * 0.6).toFixed(1));
  }

  function bestOf(trackId: string): Session | undefined {
    return (tdData?.sessions ?? []).filter((s) => s.track === trackId)
      .sort((a, b) => lapSecs(a.best) - lapSecs(b.best))[0];
  }

  function mapSvg(t: Track): string {
    const m = t.map ? MAPS[t.map] : undefined;
    if (!m) {
      // no known layout yet: an honest placeholder, clearly not a real track
      return `<svg class="td-map pending" viewBox="0 0 1000 620" role="img" aria-label="Track map pending">
        <defs><pattern id="g-${t.id}" width="40" height="40" patternUnits="userSpaceOnUse"><circle cx="2" cy="2" r="1.6" class="dot"/></pattern></defs>
        <rect x="170" y="150" width="660" height="320" rx="160" class="pend-line"/>
        <line x1="0" y1="0" x2="0" y2="620" class="scan"/>
        <text x="500" y="300" class="pend-big">TRACE PENDING</text>
        <text x="500" y="345" class="pend-small">the real layout is drawn from your first GPS session</text>
      </svg>`;
    }
    return `<svg class="td-map" viewBox="0 0 1000 620" role="img" aria-label="${esc(t.name)} layout">
      <defs>
        <filter id="glow-${t.id}" x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="7" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>
        <pattern id="g-${t.id}" width="40" height="40" patternUnits="userSpaceOnUse"><circle cx="2" cy="2" r="1.6" class="dot"/></pattern>
      </defs>
      <path d="${m.d}" class="tarmac"/>
      <path d="${m.d}" class="kerbline"/>
      <path d="${m.d}" class="race-line" filter="url(#glow-${t.id})" pathLength="1000"/>
      <line x1="${m.start[0]}" y1="${m.start[1] - 22}" x2="${m.start[0]}" y2="${m.start[1] + 22}" class="start"/>
      <text x="${m.start[0] + 8}" y="${m.start[1] + 48}" class="lbl">START / FINISH</text>
      ${m.labels.map(([s, x, y]) => `<text x="${x}" y="${y}" class="lbl dim">${s}</text>`).join('')}
      <g class="ghost" style="display: none"><circle r="20" class="ghost-halo"/><circle r="8" class="ghost-dot"/></g>
    </svg>`;
  }

  function showTrack(id: string, dir = 0) {
    if (!tdData) return;
    tdSel = id;
    const idx = tdData.tracks.findIndex((x) => x.id === id);
    const t = tdData.tracks[idx];
    const best = bestOf(id);
    const pbSecs = best ? lapSecs(best.best) : 0;
    const sessions = tdData.sessions.filter((s) => s.track === id).sort((a, b) => b.date.localeCompare(a.date));
    document.querySelectorAll<HTMLElement>('.td-tab').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.track === id)));
    const vehicles = tdBuilds.filter((b) => !b.sold).map((b) => b.name);
    const facts = [
      t.kind, t.location, t.length_km ? `${t.length_km} km` : '', t.turns ? `${t.turns} turns` : '',
    ].filter(Boolean);

    const stage = document.getElementById('td-stage')!;
    stage.style.setProperty('--c', t.color);
    stage.querySelectorAll<HTMLElement>('.sz').forEach((el) => el.classList.toggle('on', el.dataset.track === id));
    stage.querySelector('.td-hud')!.innerHTML = `<b>TRACK ${String(idx + 1).padStart(2, '0')}/${String(tdData.tracks.length).padStart(2, '0')}</b>
      <i class="hud-lock">LOCKING ON…</i><i class="hud-ok">${t.map ? 'GPS LOCKED' : 'AWAITING GPS'}</i>`;
    stage.querySelector('.ghost-tag')?.remove();
    if (best) stage.querySelector('.td-mapwrap')!.insertAdjacentHTML('beforeend', `<span class="ghost-tag mono">GHOST LAP · ${esc(best.best)}</span>`);
    stage.querySelector('.td-info')!.outerHTML = `
      <div class="td-info">
        <div class="td-top">
          <span class="td-chip ${t.status}">${t.status === 'planned' ? 'Upcoming' : 'Ridden'}</span>
          ${t.alias ? `<span class="td-alias mono">${esc(t.alias)}</span>` : ''}
        </div>
        <h3 class="td-name display">${esc(t.name)}</h3>
        <p class="td-facts mono">${facts.map(esc).join(' · ')}</p>
        <div class="td-pb lcd">
          <span>PERSONAL BEST</span>
          <b class="lcd-text">${best ? esc(best.best) : '-:--.---'}</b>
          <em class="mono">${best ? `${esc(best.vehicle || '')}${best.vehicle ? ' · ' : ''}${esc(best.date)}` : t.status === 'planned' ? 'Not ridden yet — on the list' : 'Log your first session below'}</em>
        </div>
        <div class="td-bar">
          <p class="eyebrow">Sessions — latest first</p>
          <button class="add-btn" type="button" data-td-add>+ Add session</button>
        </div>
        <form class="td-form" hidden>
          <div class="tf-row">
            <input name="date" type="date" required />
            <input name="best" placeholder="Best lap  1:02.345" pattern="^(\\d{1,2}:)?\\d{1,2}\\.\\d{1,3}$" required />
          </div>
          <select name="vehicle"><option>Rental kart</option>${vehicles.map((v) => `<option>${esc(v)}</option>`).join('')}</select>
          <input name="notes" maxlength="300" placeholder="Notes — conditions, tyres, setup…" />
          <div class="lf-actions">
            <button class="btn btn-primary" type="submit">Save ▸</button>
            <button class="btn" type="button" data-td-cancel>Cancel</button>
            <span class="lf-msg lcd-text"></span>
          </div>
        </form>
        <ol class="td-sessions">${sessions.length ? sessions.map((s) => {
          const d = lapSecs(s.best) - pbSecs;
          return `<li class="${d === 0 ? 'pb' : ''}">
            <span class="ts-date lcd-text">${esc(s.date)}</span>
            <span class="ts-lap lcd-text">${esc(s.best)}</span>
            <span class="ts-delta mono">${fmtDelta(d)}</span>
            <span class="ts-meta">${esc(s.vehicle || '')}${s.notes ? ` — ${esc(s.notes)}` : ''}</span>
            <button class="del" type="button" aria-label="Delete session" data-td-del='${esc(JSON.stringify(s))}'>✕</button>
          </li>`;
        }).join('') : `<li class="empty">${t.status === 'planned' ? 'Not ridden yet.' : 'No sessions logged yet.'}</li>`}</ol>
      </div>`;
    startGhost(pbSecs);
    if (dir && !reduced) {
      stage.style.setProperty('--dir', String(dir));
      stage.classList.remove('td-in'); void stage.offsetWidth; stage.classList.add('td-in');
      rollPb(stage.querySelector<HTMLElement>('.td-pb b')!, best?.best ?? '');
    }
  }

  // --- track change: carousel brings the track round to the front, info panel swaps ---
  let tdSwap = 0;
  function switchTrack(id: string, spin = true) {
    if (!tdData || id === tdSel) return;
    const ids = tdData.tracks.map((t) => t.id);
    const to = ids.indexOf(id), from = ids.indexOf(tdSel);
    if (spin) trackSpin.to(frontAngle(to, trackSpin.angle), 950);
    // slide the info panel the way the carousel turns
    const dir = (((to - from) % ids.length) + ids.length) % ids.length <= ids.length / 2 ? 1 : -1;
    if (reduced) { showTrack(id); return; }
    const n = ++tdSwap;
    const stage = document.getElementById('td-stage')!;
    document.querySelectorAll<HTMLElement>('.td-tab').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.track === id)));
    stage.style.setProperty('--dir', String(dir));
    stage.classList.remove('td-in'); void stage.offsetWidth; stage.classList.add('td-out');
    setTimeout(() => {
      if (n !== tdSwap) return; // a newer pick wins
      stage.classList.remove('td-out');
      showTrack(id, dir);
    }, 260);
  }

  // timing-board roll: digits count up to the PB (or scramble when there's none)
  function rollPb(el: HTMLElement, best: string) {
    const fmt = (v: number) => `${Math.floor(v / 60)}:${(v % 60).toFixed(3).padStart(6, '0')}`;
    const target = best ? lapSecs(best) : 0;
    const t0 = performance.now(), dur = target ? 900 : 520;
    const rnd = (n: number, w: number) => String(Math.floor(Math.random() * n)).padStart(w, '0');
    const step = (now: number) => {
      if (!el.isConnected) return;
      const k = Math.min(1, (now - t0) / dur);
      if (k >= 1) { el.textContent = best || '-:--.---'; return; }
      el.textContent = target ? fmt(target * (1 - Math.pow(1 - k, 3))) : `${rnd(10, 1)}:${rnd(60, 2)}.${rnd(1000, 3)}`;
      requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  }

  // ghost dot laps the map in exactly the PB time
  function startGhost(pbSecs: number) {
    cancelAnimationFrame(ghostRaf);
    document.querySelectorAll<SVGGElement>('#td-stage .ghost').forEach((g) => { g.style.display = 'none'; });
    const path = document.querySelector<SVGPathElement>('#td-stage .sz.on .race-line');
    const ghost = document.querySelector<SVGGElement>('#td-stage .sz.on .ghost');
    if (!path || !ghost || !pbSecs) return;
    ghost.style.display = ''; // SVG ignores the hidden attribute
    const len = path.getTotalLength();
    const t0 = performance.now();
    const step = (now: number) => {
      const p = reduced ? 0 : (((now - t0) / 1000) % pbSecs) / pbSecs;
      const pt = path.getPointAtLength(p * len);
      ghost.setAttribute('transform', `translate(${pt.x} ${pt.y})`);
      if (!reduced) ghostRaf = requestAnimationFrame(step);
    };
    ghostRaf = requestAnimationFrame(step);
  }

  const tdEl = document.getElementById('trackday')!;
  const tdStage = document.getElementById('td-stage')!;
  const trackSpin = spinner(tdStage, {
    grab: '.susan',
    step: stepDeg,
    apply: (a) => placeCarousel(a),
    onSettle: (a) => {
      if (!tdData) return;
      const n = tdData.tracks.length;
      const i = ((Math.round(-a / stepDeg()) % n) + n) % n;
      switchTrack(tdData.tracks[i].id, false);
    },
  });
  window.addEventListener('resize', () => placeCarousel(trackSpin.angle));
  tdEl.addEventListener('pointermove', (e) => {
    const w = (e.target as HTMLElement).closest<HTMLElement>('.td-mapwrap');
    if (!w) return;
    const r = w.getBoundingClientRect();
    w.style.setProperty('--mx', `${e.clientX - r.left}px`);
    w.style.setProperty('--my', `${e.clientY - r.top}px`);
  });
  tdEl.addEventListener('click', async (e) => {
    const el = e.target as HTMLElement;
    const tab = el.closest<HTMLElement>('[data-track]');
    if (tab) { switchTrack(tab.dataset.track!); return; }
    const form = tdEl.querySelector<HTMLFormElement>('.td-form');
    if (el.closest('[data-td-add]') && form) {
      form.hidden = !form.hidden;
      if (!form.hidden) (form.elements.namedItem('date') as HTMLInputElement).value = localNow().slice(0, 10);
      return;
    }
    if (el.closest('[data-td-cancel]') && form) { form.hidden = true; return; }
    const del = el.closest<HTMLButtonElement>('[data-td-del]');
    if (del) {
      if (!del.classList.contains('armed')) {
        del.classList.add('armed'); del.textContent = 'Delete?';
        setTimeout(() => { del.classList.remove('armed'); del.textContent = '✕'; }, 3000);
        return;
      }
      const s: Session = JSON.parse(del.dataset.tdDel!);
      const res = await fetch(`${API_BASE}/api/garage/trackday/${encodeURIComponent(tdSel)}/session`, {
        method: 'DELETE', headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token()}` },
        body: JSON.stringify({ date: s.date, best: s.best, vehicle: s.vehicle ?? '', notes: s.notes ?? '' }),
      });
      if (res.ok) renderTrackday(await res.json(), tdBuilds);
    }
  });
  tdEl.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const msg = form.querySelector('.lf-msg')!;
    const body = Object.fromEntries(new FormData(form) as any);
    msg.textContent = 'SAVING…';
    try {
      const res = await fetch(`${API_BASE}/api/garage/trackday/${encodeURIComponent(tdSel)}/session`, {
        method: 'POST', headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token()}` },
        body: JSON.stringify(body),
      });
      if (res.status === 401) { localStorage.removeItem(KEY); location.reload(); return; }
      if (!res.ok) { msg.textContent = 'CHECK THE LAP TIME FORMAT'; return; }
      renderTrackday(await res.json(), tdBuilds);
    } catch {
      msg.textContent = 'NO SIGNAL — BACKEND OFFLINE?';
    }
  });

  // --- build log editing: + Add log / Save / Cancel / delete (✕, tap twice) ----
  const buildsEl = document.getElementById('builds')!;
  const token = () => localStorage.getItem(KEY) ?? '';
  const localNow = () => {
    const d = new Date(); d.setMinutes(d.getMinutes() - d.getTimezoneOffset());
    return d.toISOString().slice(0, 16); // YYYY-MM-DDTHH:MM in local time
  };
  async function logRequest(method: 'POST' | 'DELETE', id: string, body: LogItem): Promise<boolean> {
    const res = await fetch(`${API_BASE}/api/garage/${encodeURIComponent(id)}/log`, {
      method, headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token()}` },
      body: JSON.stringify(body),
    });
    if (res.status === 401) { localStorage.removeItem(KEY); location.reload(); } // session expired → lock screen
    return res.ok;
  }

  buildsEl.addEventListener('click', async (e) => {
    const t = e.target as HTMLElement;
    const add = t.closest<HTMLElement>('[data-add]');
    if (add) {
      const form = buildsEl.querySelector<HTMLFormElement>(`.log-form[data-build="${add.dataset.add}"]`)!;
      form.hidden = !form.hidden;
      if (!form.hidden) {
        (form.elements.namedItem('when') as HTMLInputElement).value = localNow();
        (form.elements.namedItem('note') as HTMLTextAreaElement).focus();
      }
      return;
    }
    if (t.closest('[data-cancel]')) { (t.closest('form') as HTMLFormElement).hidden = true; return; }
    if (t.closest('[data-back]')) { document.getElementById('select')!.scrollIntoView({ behavior: reduced ? 'auto' : 'smooth', block: 'start' }); return; }
    const rv = t.closest<HTMLButtonElement>('[data-review]');
    if (rv) {
      const open = rv.closest('.review')!.classList.toggle('open');
      rv.textContent = open ? 'Show less ▴' : 'Read full review ▸';
      return;
    }
    const del = t.closest<HTMLButtonElement>('[data-del]');
    if (del) {
      if (!del.classList.contains('armed')) {           // first tap arms it, second tap deletes
        del.classList.add('armed'); del.textContent = 'Delete?';
        setTimeout(() => { del.classList.remove('armed'); del.textContent = '✕'; }, 3000);
        return;
      }
      del.disabled = true;
      const ok = await logRequest('DELETE', del.dataset.del!, { date: del.dataset.date!, time: del.dataset.time ?? '', note: del.dataset.note! });
      if (ok) await loadGarage(token(), true);
    }
  });

  buildsEl.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const msg = form.querySelector('.lf-msg')!;
    const when = (form.elements.namedItem('when') as HTMLInputElement).value; // YYYY-MM-DDTHH:MM
    const note = (form.elements.namedItem('note') as HTMLTextAreaElement).value.trim();
    if (!when || !note) { msg.textContent = 'DATE + NOTE NEEDED'; return; }
    msg.textContent = 'SAVING…';
    const [date, time = ''] = when.split('T');
    try {
      const ok = await logRequest('POST', form.dataset.build!, { date, time: time.slice(0, 5), note });
      if (!ok) { msg.textContent = 'COULD NOT SAVE'; return; }
      await loadGarage(token(), true);
    } catch {
      msg.textContent = 'NO SIGNAL — BACKEND OFFLINE?';
    }
  });

  // auto-unlock if a valid token is stored
  const saved = localStorage.getItem(KEY);
  if (saved) loadGarage(saved).then((ok) => { if (!ok) localStorage.removeItem(KEY); }).catch(() => {});

  document.getElementById('auth-form')!.addEventListener('submit', async (e) => {
    e.preventDefault();
    err.textContent = '';
    gate.classList.remove('denied');
    const pw = (document.getElementById('pw') as HTMLInputElement).value;
    try {
      const res = await fetch(`${API_BASE}/api/auth`, {
        method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ password: pw }),
      });
      if (!res.ok) {
        err.textContent = 'ACCESS DENIED';
        void gate.offsetWidth; gate.classList.add('denied');
        return;
      }
      const { token } = await res.json();
      localStorage.setItem(KEY, token);
      await loadGarage(token);
    } catch {
      err.textContent = 'NO SIGNAL — IS THE BACKEND RUNNING?';
    }
  });

  // --- Forza-style screens: GARAGE <-> TRACK DAY ------------------------------------
  type Pane = 'garage' | 'track' | 'stats';
  const PANES: Pane[] = ['garage', 'track', 'stats'];
  const LABEL: Record<Pane, string> = { garage: 'Garage', track: 'Track Day', stats: 'Stats' };
  const fzm = document.getElementById('fzm')!;
  const ink = fzm.querySelector<HTMLElement>('.fzm-ink')!;
  const slash = document.getElementById('slash')!;
  let pane: Pane = 'garage';
  let switching = false;
  const paneFromHash = (): Pane => (PANES.find((p) => p !== 'garage' && location.hash === `#${p}`) ?? 'garage');
  const step = (d: 1 | -1): Pane | undefined => PANES[PANES.indexOf(pane) + d];
  const paneEl = (p: Pane) => document.querySelector<HTMLElement>(`.pane[data-pane="${p}"]`)!;

  function moveInk() {
    const tab = fzm.querySelector<HTMLElement>(`.fzm-tab[data-pane-go="${pane}"]`);
    if (!tab || !tab.offsetWidth) return;
    ink.style.left = `${tab.offsetLeft}px`;
    ink.style.width = `${tab.offsetWidth}px`;
  }

  function chrome() { // tabs, underline and edge arrows follow the current screen
    fzm.querySelectorAll<HTMLElement>('.fzm-tab').forEach((t) => t.setAttribute('aria-selected', String(t.dataset.paneGo === pane)));
    ([['.edge-next', step(1)], ['.edge-prev', step(-1)]] as const).forEach(([sel, to]) => {
      const b = document.querySelector<HTMLElement>(sel)!;
      b.hidden = !to;
      if (!to) return;
      b.dataset.paneGo = to;
      b.querySelector('span')!.textContent = LABEL[to];
      b.setAttribute('aria-label', `Go to ${LABEL[to]}`);
    });
    moveInk();
  }

  function swap(to: Pane) {
    PANES.forEach((p) => { paneEl(p).hidden = p !== to; paneEl(p).classList.toggle('on', p === to); });
    pane = to;
    if (to === 'track' && tdSel) showTrack(tdSel); // replay the race-line draw + ghost
    if (to === 'stats') loadStats();
    // keep the tab bar in view (the jump happens under the slash)
    const top = fzm.getBoundingClientRect().top + window.scrollY - 90;
    if (window.scrollY > top) window.scrollTo({ top, behavior: 'instant' as ScrollBehavior });
    window.dispatchEvent(new Event('scroll')); // let the scroll animations notice the new screen
  }

  function setPane(to: Pane, animate = true, push = false) {
    if (switching || (to === pane && !paneEl(to).hidden && paneEl(to).classList.contains('on'))) { chrome(); return; }
    if (push) history.pushState(null, '', to === 'garage' ? location.pathname + location.search : `#${to}`);
    const from = pane;
    if (!animate || reduced || from === to) { swap(to); chrome(); return; }
    switching = true;
    const dir = PANES.indexOf(to) > PANES.indexOf(from) ? 'fwd' : 'back';
    const out = paneEl(from), inn = paneEl(to);
    document.getElementById('slash-label')!.textContent = LABEL[to];
    slash.classList.remove('fwd', 'back'); void slash.offsetWidth; slash.classList.add(dir);
    out.classList.add(`out-${dir}`);
    pane = to; chrome(); // underline starts gliding with the slash
    setTimeout(() => {
      out.classList.remove(`out-${dir}`);
      swap(to);
      inn.classList.add(`in-${dir}`);
    }, 330);
    setTimeout(() => {
      inn.classList.remove(`in-${dir}`);
      slash.classList.remove(dir);
      switching = false;
    }, 860);
  }

  const go = (to: Pane) => setPane(to, true, true);
  content.addEventListener('click', (e) => {
    const b = (e.target as HTMLElement).closest<HTMLElement>('[data-pane-go]');
    if (b) go(b.dataset.paneGo as Pane);
  });
  // Q / E like a controller's bumpers (arrow keys too) — not while typing
  window.addEventListener('keydown', (e) => {
    if (content.hidden || e.ctrlKey || e.metaKey || e.altKey) return;
    if ((e.target as HTMLElement).closest('input, textarea, select, [contenteditable]')) return;
    const k = e.key.toLowerCase();
    const to = k === 'q' || k === 'arrowleft' ? step(-1) : k === 'e' || k === 'arrowright' ? step(1) : undefined;
    if (to) go(to);
  });
  // swipe left / right on phones
  let sx = 0, sy = 0, sOk = false;
  const panes = document.getElementById('panes')!;
  panes.addEventListener('touchstart', (e) => {
    const t = e.touches[0];
    sx = t.clientX; sy = t.clientY;
    // things that scroll sideways themselves keep their swipe
    sOk = e.touches.length === 1 && !(e.target as HTMLElement).closest('.td-tabs, .fz-grid, .slides, .show, .b-media, input, textarea, .td-mapwrap');
  }, { passive: true });
  panes.addEventListener('touchend', (e) => {
    if (!sOk) return;
    const t = e.changedTouches[0];
    const dx = t.clientX - sx, dy = t.clientY - sy;
    const to = Math.abs(dx) > 70 && Math.abs(dx) > Math.abs(dy) * 1.8 ? step(dx < 0 ? 1 : -1) : undefined;
    if (to) go(to);
  }, { passive: true });
  window.addEventListener('popstate', () => { if (!content.hidden) setPane(paneFromHash()); });

  // --- STATS: private telemetry ------------------------------------------------------
  type Row = { name: string; count: number };
  type Report = {
    today: number; month: number; total: number; online: number;
    days: { day: string; visitors: number; views: number }[]; refs: Row[]; projects: Row[]; events: Row[];
  };
  let projectNames: Record<string, string> | null = null;
  async function loadStats() {
    const body = document.getElementById('st-body')!;
    const res = await fetch(`${API_BASE}/api/stats`, { headers: { Authorization: `Bearer ${token()}` } }).catch(() => null);
    if (!res || !res.ok) { body.innerHTML = '<p class="st-empty mono">No telemetry — is the backend running?</p>'; return; }
    const r: Report = await res.json();
    projectNames ??= await fetch(`${API_BASE}/api/content`).then((x) => x.json())
      .then((c) => Object.fromEntries((c.projects ?? []).map((p: { id: string; tag: string }) => [p.id, p.tag]))).catch(() => ({}));
    const fmt = (n: number) => n.toLocaleString('en-US');
    const peak = Math.max(1, ...r.days.map((d) => d.visitors));
    const best = r.days.reduce((a, d) => (d.visitors > a.visitors ? d : a), r.days[0]);
    const bars = r.days.map((d, i) => {
      const h = Math.max(2, (d.visitors / peak) * 100);
      const cls = i === r.days.length - 1 ? 'today' : d === best && d.visitors ? 'best' : '';
      return `<rect x="${i * 10 + 1}" y="${100 - h}" width="8" height="${h}" class="${cls}"><title>${d.day}: ${d.visitors} visitors, ${d.views} views</title></rect>`;
    }).join('');
    const list = (rows: Row[], empty: string, name = (n: string) => n) => rows.length
      ? `<ol class="st-list">${rows.map((x) => `<li><span>${esc(name(x.name))}</span><b class="lcd-text">${fmt(x.count)}</b></li>`).join('')}</ol>`
      : `<p class="st-empty mono">${empty}</p>`;
    const EV: Record<string, string> = { game: 'Lights Out games', contact: 'Messages sent' };
    body.innerHTML = `
      <div class="st-kpis">
        ${[['On track now', r.online, 'green'], ['Today', r.today, 'amber'], ['This month', r.month, 'pink'], ['All time', r.total, 'purple']]
          .map(([k, v, c]) => `<div class="st-kpi" style="--c: var(--${c})"><span class="mono">${k}</span><b class="lcd-text">${fmt(Number(v))}</b></div>`).join('')}
      </div>
      <div class="st-chart">
        <div class="st-chart-head"><p class="eyebrow">Visitors — last 30 days</p>
          <span class="mono">best day ${best && best.visitors ? `${esc(best.day)} · ${best.visitors}` : '—'}</span></div>
        <svg viewBox="0 0 300 100" preserveAspectRatio="none" role="img" aria-label="Daily visitors, last 30 days">${bars}</svg>
        <div class="st-axis mono"><span>${esc(r.days[0]?.day ?? '')}</span><span>today</span></div>
      </div>
      <div class="st-cols">
        <div><p class="eyebrow">Projects people looked at</p>${list(r.projects, 'No project views yet.', (n) => projectNames?.[n] ?? n.toUpperCase())}</div>
        <div><p class="eyebrow">Where they came from</p>${list(r.refs, 'Mostly direct visits so far.')}</div>
        <div><p class="eyebrow">Actions</p>${list(r.events.filter((e) => EV[e.name]), 'No games or messages yet.', (n) => EV[n] ?? n)}</div>
      </div>`;
    document.getElementById('st-upd')!.textContent = `UPDATED ${new Date().toTimeString().slice(0, 5)}`;
  }
  window.addEventListener('resize', moveInk);
  document.fonts?.ready.then(moveInk);

  document.getElementById('lock-out')!.addEventListener('click', () => {
    localStorage.removeItem(KEY);
    content.hidden = true;
    gate.hidden = false;
    (document.getElementById('pw') as HTMLInputElement).value = '';
  });
</script>
